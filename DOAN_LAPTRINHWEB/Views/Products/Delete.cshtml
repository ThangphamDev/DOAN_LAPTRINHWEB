@model DOAN_LAPTRINHWEB.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h3 class="m-0"><i class="fas fa-exclamation-triangle me-2"></i>Xác nhận xóa sản phẩm</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <p class="mb-0">Bạn có chắc chắn muốn xóa sản phẩm này? Hành động này không thể hoàn tác.</p>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4 text-center">
                            <div class="p-3 border rounded bg-light mb-3">
                                <i class="fas fa-box fa-4x text-muted"></i>
                            </div>
                            <h5>@Model.Name</h5>
                            <p class="product-price">@(Model.Price.ToString("N0") ?? "0")đ</p>
                        </div>
                        <div class="col-md-8">
                            <dl class="row">
                                <dt class="col-sm-4">Tên sản phẩm</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

                                <dt class="col-sm-4">Mô tả</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Description)</dd>

                                <dt class="col-sm-4">Giá</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Price)đ</dd>

                                <dt class="col-sm-4">Số lượng</dt>
                                <dd class="col-sm-8">
                                    @if (Model.Stock > 10)
                                    {
                                        <span class="badge bg-success">@Html.DisplayFor(model => model.Stock)</span>
                                    }
                                    else if (Model.Stock > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@Html.DisplayFor(model => model.Stock)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Hết hàng</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Ngày tạo</dt>
                                <dd class="col-sm-8">@(Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa có thông tin")</dd>

                                <dt class="col-sm-4">Cập nhật lần cuối</dt>
                                <dd class="col-sm-8">@(Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật")</dd>

                                <dt class="col-sm-4">Danh mục</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-info text-dark">@Html.DisplayFor(model => model.Category.Name)</span>
                                </dd>
                            </dl>
                        </div>
                    </div>

                    <form asp-action="Delete" class="text-end">
                        <input type="hidden" asp-for="ProductId" />
                        <a asp-action="Index" class="btn btn-outline-secondary me-2">
                            <i class="fas fa-arrow-left me-1"></i>Quay lại
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash-alt me-1"></i>Xóa sản phẩm
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>