@model IEnumerable<DOAN_LAPTRINHWEB.Models.Product>

@{
    ViewData["Title"] = "Danh Sách Sản Phẩm";
}

<style>
/* Sử dụng cùng color scheme và variables với trang chủ */
:root {
    --primary-color: #212529;
    --secondary-color: #f8f9fa;
    --accent-color: #f59e0b;
    --text-color: #212529;
    --light-color: #ffffff;
    --danger-color: #dc3545;
    --success-color: #198754;
    --border-radius: 8px;
    --box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    --transition: all 0.3s ease;
}

body {
    font-family: 'Poppins', sans-serif;
    color: var(--text-color);
    background-color: var(--secondary-color);
}

/* Hero Banner giống trang chủ */
.products-hero {
    background: linear-gradient(rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.8)), url('../images/dashboad/banner.png') no-repeat center center;
    background-size: cover;
    padding: 100px 0;
    position: relative;
}

.products-hero h1 {
    font-weight: 700;
    color: var(--primary-color);
    margin-bottom: 20px;
}

.products-hero .lead {
    font-size: 1.2rem;
    margin-bottom: 30px;
    color: #6c757d;
}

/* Toolbar với thiết kế tương tự trang chủ */
.products-toolbar {
    background: var(--light-color);
    border-radius: var(--border-radius);
    padding: 20px;
    box-shadow: var(--box-shadow);
    margin: -50px 0 40px 0;
    position: relative;
    z-index: 10;
}

.products-count {
    font-size: 0.95rem;
    color: #6c757d;
    display: flex;
    align-items: center;
    gap: 8px;
}

.products-count strong {
    color: var(--primary-color);
    font-weight: 600;
}

.products-count-badge {
    background: var(--primary-color);
    color: var(--light-color);
    padding: 4px 12px;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 600;
}

.search-box {
    position: relative;
    max-width: 400px;
}

.search-box input {
    border: 1px solid #dee2e6;
    border-radius: 50px;
    padding: 12px 20px 12px 50px;
    font-size: 0.95rem;
    transition: var(--transition);
    background: var(--secondary-color);
}

.search-box input:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(33,37,41,0.1);
}

.search-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: #6c757d;
}

.view-toggle {
    display: flex;
    background: var(--secondary-color);
    border-radius: var(--border-radius);
    padding: 4px;
}

.view-btn {
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 6px;
    background: none;
    color: #6c757d;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
}

.view-btn.active {
    background: var(--light-color);
    color: var(--primary-color);
    box-shadow: var(--box-shadow);
}

.sort-select {
    border: 1px solid #dee2e6;
    border-radius: 50px;
    padding: 12px 20px;
    background: var(--light-color);
    color: var(--primary-color);
    font-weight: 500;
}

/* Product Sidebar Filter Styles */
.products-layout {
    display: flex;
    gap: 30px;
    margin-top: 20px;
}

.products-sidebar {
    width: 280px;
    flex-shrink: 0;
}

.products-content {
    flex-grow: 1;
    min-width: 0; /* Prevent content from expanding beyond container */
}

.sidebar-block {
    background-color: var(--light-color);
    border-radius: var(--border-radius);
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: var(--box-shadow);
}

.sidebar-block h4 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 15px;
    color: var(--primary-color);
    padding-bottom: 10px;
    border-bottom: 1px solid #f1f1f1;
}

/* Category Filter Styles */
.sidebar-categories {
    list-style: none;
    padding: 0;
    margin: 0;
}

.sidebar-categories li {
    margin-bottom: 10px;
}

.sidebar-categories a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--text-color);
    text-decoration: none;
    padding: 8px 15px;
    border-radius: 6px;
    transition: all 0.2s ease;
}

.sidebar-categories a:hover {
    background-color: rgba(0, 0, 0, 0.05);
    transform: translateX(5px);
}

.sidebar-categories a.active {
    background-color: var(--primary-color);
    color: var(--light-color);
}

.sidebar-categories .count {
    background-color: rgba(0, 0, 0, 0.08);
    padding: 2px 8px;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 500;
}

.sidebar-categories a.active .count {
    background-color: rgba(255, 255, 255, 0.2);
}

/* Price Range Slider */
.price-slider {
    margin-top: 20px;
}

.price-range {
    display: flex;
    align-items: center;
    margin-top: 15px;
}

.price-input {
    width: 100px;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    padding: 6px 8px;
    font-size: 0.9rem;
}

.price-separator {
    margin: 0 10px;
    color: #6c757d;
}

/* Filter Checkboxes */
.sidebar-filter-item {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
}

.sidebar-filter-item .form-check {
    margin-bottom: 0;
    width: 100%;
}

.sidebar-filter-item .form-check-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    cursor: pointer;
}

.sidebar-filter-item .count {
    font-size: 0.8rem;
    color: #6c757d;
}

/* Color filters */
.color-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 5px;
}

.color-filter {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    cursor: pointer;
    position: relative;
    border: 1px solid #dee2e6;
    transition: all 0.2s ease;
}

.color-filter:hover {
    transform: scale(1.1);
}

.color-filter.active::after {
    content: '\f00c';
    font-family: 'Font Awesome 5 Free';
    font-weight: 900;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #fff;
    text-shadow: 0 0 2px rgba(0, 0, 0, 0.5);
    font-size: 0.8rem;
}

/* Filter Clear Button */
.filter-clear {
    color: var(--danger-color);
    font-size: 0.9rem;
    text-decoration: none;
    display: block;
    margin-top: 15px;
    text-align: center;
}

.filter-clear:hover {
    text-decoration: underline;
}

/* Responsive Filters */
.filter-toggle {
    display: none;
    width: 100%;
    padding: 10px;
    background-color: var(--primary-color);
    color: var(--light-color);
    border: none;
    border-radius: var(--border-radius);
    margin-bottom: 20px;
    font-weight: 500;
    text-align: center;
}

/* Product Grid giống style trang chủ */
.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 30px;
}

/* Animation cho sản phẩm */
@@keyframes fadeInUp {
    from { 
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.product-card {
    background: var(--light-color);
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: var(--box-shadow);
    transition: var(--transition);
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    border: none;
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
}

/* Animation delays */
.product-card:nth-child(1) { animation-delay: 0.1s; }
.product-card:nth-child(2) { animation-delay: 0.2s; }
.product-card:nth-child(3) { animation-delay: 0.3s; }
.product-card:nth-child(4) { animation-delay: 0.4s; }
.product-card:nth-child(5) { animation-delay: 0.5s; }
.product-card:nth-child(6) { animation-delay: 0.6s; }
.product-card:nth-child(7) { animation-delay: 0.7s; }
.product-card:nth-child(8) { animation-delay: 0.8s; }
.product-card:nth-child(n+9) { animation-delay: 0.9s; }

.product-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
}

.product-image {
    position: relative;
    overflow: hidden;
    height: 250px;
}

.product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.product-card:hover .product-image img {
    transform: scale(1.05);
}

/* Badges giống trang chủ */
.product-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--light-color);
    z-index: 2;
}

.badge-new {
    background: var(--success-color);
}

.badge-sale {
    background: var(--danger-color);
}

/* Wishlist button giống trang chủ */
.product-wishlist {
    position: absolute;
    top: 15px;
    right: 15px;
    background: var(--light-color);
    width: 35px;
    height: 35px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
    z-index: 2;
    opacity: 0;
    transform: scale(0.8);
}

.product-card:hover .product-wishlist {
    opacity: 1;
    transform: scale(1);
}

.product-wishlist:hover {
    background: #f8d7da;
    transform: scale(1.1);
}

.product-wishlist:hover i {
    color: var(--danger-color);
}

/* Action buttons overlay */
.product-actions {
    position: absolute;
    bottom: 15px;
    left: 15px;
    right: 15px;
    display: flex;
    gap: 10px;
    opacity: 0;
    transform: translateY(20px);
    transition: var(--transition);
}

.product-card:hover .product-actions {
    opacity: 1;
    transform: translateY(0);
}

.action-btn {
    flex: 1;
    padding: 10px;
    border: none;
    border-radius: var(--border-radius);
    background: rgba(255, 255, 255, 0.95);
    color: var(--primary-color);
    font-weight: 600;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    transition: var(--transition);
    backdrop-filter: blur(10px);
}

.action-btn:hover {
    background: var(--primary-color);
    color: var(--light-color);
    transform: translateY(-2px);
}

/* Card body giống trang chủ */
.product-info {
    padding: 20px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
}

.product-category {
    font-size: 0.8rem;
    color: #6c757d;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.product-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 10px;
    color: var(--primary-color);
    line-height: 1.3;
}

.product-title a {
    color: inherit;
    text-decoration: none;
    transition: var(--transition);
}

.product-title a:hover {
    color: var(--accent-color);
}

.product-rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
}

.rating-stars {
    color: #ffc107;
    font-size: 0.9rem;
}

.rating-text {
    color: #6c757d;
    font-size: 0.85rem;
}

.product-description {
    color: #6c757d;
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 15px;
    flex-grow: 1;
}

.product-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 15px;
    border-top: 1px solid #f1f1f1;
}

.product-price {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--primary-color);
}

.price-old {
    font-size: 0.9rem;
    color: #6c757d;
    text-decoration: line-through;
    margin-right: 8px;
}

.btn-cart {
    background: var(--primary-color);
    color: var(--light-color);
    border: none;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: var(--transition);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 5px;
}

.btn-cart:hover {
    background: #000;
    color: var(--light-color);
    transform: translateY(-2px);
}

/* List view */
.products-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
}

.products-list .product-card {
    display: grid;
    grid-template-columns: 280px 1fr;
    height: auto;
}

.products-list .product-image {
    height: 100%;
}

.products-list .product-info {
    padding: 20px 30px;
}

.products-list .product-actions {
    position: static;
    opacity: 1;
    transform: none;
    margin-top: 15px;
}

/* Empty state giống trang chủ */
.empty-state {
    text-align: center;
    padding: 80px 20px;
    background: var(--light-color);
    border-radius: var(--border-radius);
    box-shadow: var(--box-shadow);
}

.empty-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 30px;
    background: var(--secondary-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    color: var(--primary-color);
}

.empty-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 15px;
    color: var(--primary-color);
}

.empty-text {
    color: #6c757d;
    margin-bottom: 30px;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
}

/* Pagination */
.pagination-container {
    margin-top: 40px;
    margin-bottom: 60px;
}

.pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
}

.pagination .page-item {
    list-style-type: none;
}

.pagination .page-link {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 1px solid #dee2e6;
    background-color: var(--light-color);
    color: var(--text-color);
    text-decoration: none;
    transition: var(--transition);
}

.pagination .page-link:hover {
    background-color: var(--secondary-color);
    border-color: var(--primary-color);
}

.pagination .page-item.active .page-link {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
    color: var(--light-color);
}

.pagination .page-item.disabled .page-link {
    background-color: var(--secondary-color);
    color: #6c757d;
    pointer-events: none;
}

/* Filter tags */
.filter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 20px;
}

.filter-tag {
    display: inline-flex;
    align-items: center;
    background-color: var(--light-color);
    border: 1px solid #dee2e6;
    border-radius: 50px;
    padding: 8px 16px;
    cursor: pointer;
    transition: var(--transition);
}

.filter-tag:hover {
    border-color: var(--primary-color);
}

.filter-tag.active {
    background-color: var(--primary-color);
    color: var(--light-color);
    border-color: var(--primary-color);
}

.filter-tag .count {
    margin-left: 5px;
    font-size: 0.8rem;
    opacity: 0.7;
}

/* Notification */
.notification {
    position: fixed;
    top: 20px;
    right: 20px;
    background: var(--light-color);
    border-radius: var(--border-radius);
    padding: 15px 20px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.15);
    display: flex;
    align-items: center;
    gap: 15px;
    z-index: 1050;
    transform: translateX(120%);
    transition: transform 0.3s ease-out;
}

.notification.show {
    transform: translateX(0);
}

.notification-icon {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
}

.notification-icon.success {
    color: var(--success-color);
    background-color: rgba(25, 135, 84, 0.1);
}

.notification-icon.error {
    color: var(--danger-color);
    background-color: rgba(220, 53, 69, 0.1);
}

.notification-content {
    flex-grow: 1;
}

.notification-title {
    font-weight: 600;
    margin-bottom: 5px;
    font-size: 0.95rem;
}

.notification-message {
    font-size: 0.85rem;
    color: #6c757d;
    margin: 0;
}

.notification-close {
    background: none;
    border: none;
    font-size: 1.2rem;
    color: #6c757d;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Button styles giống trang chủ */
.btn {
    padding: 10px 20px;
    border-radius: var(--border-radius);
    font-weight: 500;
    transition: var(--transition);
}

.btn-dark {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
}

.btn-dark:hover {
    background-color: #000;
    border-color: #000;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
}

.btn-outline-dark {
    border-color: var(--primary-color);
    color: var(--primary-color);
}

.btn-outline-dark:hover {
    background-color: var(--primary-color);
    color: var(--light-color);
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
}


/* CSS nâng cao cho 3 nút hành động */
.product-actions {
    display: flex;
    justify-content: center; /* Căn giữa theo chiều ngang */
    align-items: center;
    gap: 10px;
    padding: 10px;
    position: absolute;
    bottom: 10px;
    left: 0;
    right: 0;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease;
}

.product-card:hover .product-actions {
    opacity: 1;
    transform: translateY(0);
}

.icon-action-btn {
    width: 45px;
    height: 45px;
    border-radius: 50%; /* Làm tròn các nút */
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    color: #333;
    font-size: 1rem;
    backdrop-filter: blur(5px);
}

.icon-action-btn:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
}

.icon-action-btn.edit-btn {
    background: linear-gradient(145deg, #ffffff, #f0f0f0);
    border: 1px solid rgba(33, 150, 243, 0.2);
}

.icon-action-btn.view-btn {
    background: linear-gradient(145deg, #ffffff, #f0f0f0);
    border: 1px solid rgba(76, 175, 80, 0.2);
}

.icon-action-btn.delete-btn {
    background: linear-gradient(145deg, #ffffff, #f0f0f0);
    border: 1px solid rgba(244, 67, 54, 0.2);
}

.icon-action-btn.edit-btn:hover {
    background: #2196F3;
    color: white;
    border-color: #2196F3;
}

.icon-action-btn.view-btn:hover {
    background: #4CAF50;
    color: white;
    border-color: #4CAF50;
}

.icon-action-btn.delete-btn:hover {
    background: #F44336;
    color: white;
    border-color: #F44336;
}

/* Hiệu ứng khi hover vào biểu tượng */
.icon-action-btn i {
    transition: transform 0.3s ease;
}

.icon-action-btn:hover i {
    transform: scale(1.2);
}

/* Animation for sidebar on small screens */
@@keyframes sidebarSlideDown {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.sidebar-collapsible.show {
    animation: sidebarSlideDown 0.3s ease forwards;
}

/* Hiển thị các nút trên thiết bị di động */
@@media (max-width: 576px) {
    .product-actions {
        opacity: 1;
        transform: translateY(0);
        position: relative;
        bottom: auto;
        margin-top: 10px;
    }
}

/* Responsive */
@@media (max-width: 991px) {
    .products-hero {
        padding: 60px 0;
        text-align: center;
    }
    
    .products-grid {
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
    }

    .products-layout {
        flex-direction: column;
    }

    .products-sidebar {
        width: 100%;
        margin-bottom: 30px;
    }

    .filter-toggle {
        display: block;
    }

    .sidebar-collapsible {
        display: none;
    }

    .sidebar-collapsible.show {
        display: block;
    }
}

@@media (max-width: 767.98px) {
    .products-toolbar {
        margin: -30px 15px 30px 15px;
        padding: 15px;
    }
    
    .products-grid {
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
        margin-top: 30px;
    }
    
    .products-list .product-card {
        grid-template-columns: 1fr;
    }
    
    .products-list .product-image {
        height: 250px;
    }
    
    .filter-tags {
        gap: 8px;
    }
    
    .filter-tag {
        padding: 6px 12px;
        font-size: 0.85rem;
    }
}

@@media (max-width: 575.98px) {
    .products-grid {
        grid-template-columns: 1fr;
    }
    
    .product-actions {
        opacity: 1;
        transform: translateY(0);
    }
    
    .product-wishlist {
        opacity: 1;
        transform: scale(1);
    }
}
/* Sticky Sidebar */
.sticky-sidebar {
    position: sticky;
    top: 80px; /* Điều chỉnh khoảng cách từ trên xuống */
    max-height: calc(100vh - 100px); /* Chiều cao tối đa để tránh quá dài */
    overflow-y: auto; /* Cho phép cuộn nếu nội dung quá dài */
}

/* Tùy chỉnh thanh cuộn cho sidebar */
.sticky-sidebar::-webkit-scrollbar {
    width: 6px;
}

.sticky-sidebar::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
}

.sticky-sidebar::-webkit-scrollbar-thumb {
    background: #c1c1c1;
    border-radius: 10px;
}

.sticky-sidebar::-webkit-scrollbar-thumb:hover {
    background: #a8a8a8;
}

/* Hiệu ứng khi cuộn */
.sticky-sidebar {
    transition: top 0.2s ease;
}

/* Đảm bảo thanh sidebar không bị che khuất trên thiết bị di động */
@@media (max-width: 991px) {
    .sticky-sidebar {
        position: static;
        max-height: none;
    }
}

</style>

<!-- Hero Section với tiêu đề động dựa trên danh mục được chọn -->
<section class="products-hero">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                @if (ViewBag.SelectedCategoryName != null)
                {
                    <h1 class="display-4 fw-bold">@ViewBag.SelectedCategoryName</h1>
                    <p class="lead">Danh sách sản phẩm trong danh mục @ViewBag.SelectedCategoryName</p>
                }
                else
                {
                    <h1 class="display-4 fw-bold">Quản Lý Sản Phẩm</h1>
                    <p class="lead">Khám phá và quản lý bộ sưu tập sản phẩm trang trí nội thất của bạn</p>
                }
                <div class="d-flex gap-3 justify-content-center">
                    <a asp-action="Create" class="btn btn-dark btn-lg">
                        <i class="fas fa-plus me-2"></i>Thêm Sản Phẩm Mới
                    </a>
                    <a href="#products" class="btn btn-outline-dark btn-lg">Xem Sản Phẩm</a>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container">
    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-box-open"></i>
            </div>
            <h2 class="empty-title">Chưa có sản phẩm nào</h2>
            <p class="empty-text">Bắt đầu xây dựng cửa hàng trang trí nội thất của bạn bằng cách thêm sản phẩm đầu tiên.</p>
            <a asp-action="Create" class="btn btn-dark btn-lg">
                <i class="fas fa-plus me-2"></i>Thêm Sản Phẩm Đầu Tiên
            </a>
        </div>
    }
    else
    {
        <!-- Toolbar -->
        <div class="products-toolbar">
            <div class="row align-items-center">
                <div class="col-md-4">
                    <div class="products-count">
                        <span>Hiển thị</span>
                        <strong>@Model.Count()</strong>
                        <span>sản phẩm</span>
                        <div class="products-count-badge">@Model.Count()</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="search-box">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" id="searchInput" placeholder="Tìm kiếm sản phẩm..." class="form-control">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-center justify-content-end gap-3">
                        <div class="view-toggle">
                            <button type="button" class="view-btn active" id="gridViewBtn" title="Hiển thị dạng lưới">
                                <i class="fas fa-th"></i>
                            </button>
                            <button type="button" class="view-btn" id="listViewBtn" title="Hiển thị dạng danh sách">
                                <i class="fas fa-list"></i>
                            </button>
                        </div>
                        <select class="form-select sort-select" id="sortProducts" style="width: auto;">
                            <option value="default">Sắp xếp</option>
                            <option value="name_asc">Tên: A-Z</option>
                            <option value="name_desc">Tên: Z-A</option>
                            <option value="price_asc">Giá: Thấp → Cao</option>
                            <option value="price_desc">Giá: Cao → Thấp</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Toggle button for mobile filters -->
        <button class="filter-toggle" id="filterToggle">
            <i class="fas fa-filter me-2"></i> Lọc Sản Phẩm
        </button>

        <!-- New products layout with sidebar -->
        <div class="products-layout">
            <!-- Products Sidebar -->
            <div class="products-sidebar">
               <div class="sidebar-collapsible sticky-sidebar" id="sidebarContent">
                    <!-- Categories Filter -->
                    <div class="sidebar-block">
                        <h4>Danh Mục</h4>
                        <ul class="sidebar-categories">
                            <li>
                                <a href="javascript:void(0)" class="category-link @(ViewBag.SelectedCategoryId == null ? "active" : "")" 
                                   data-category-id="0">
                                    <span>Tất cả sản phẩm</span>
                                    <span class="count">@Model.Count()</span>
                                </a>
                            </li>
        
                            @foreach (var category in Model.Where(p => p.Category != null).Select(p => p.Category).Distinct())
                            {
                                if (category != null)
                                {
                                    var itemCount = Model.Count(p => p.CategoryId == category.CategoryId);
                                    <li>
                                        <a href="javascript:void(0)" 
                                           class="category-link @(ViewBag.SelectedCategoryId == category.CategoryId ? "active" : "")"
                                           data-category-id="@category.CategoryId"
                                           data-category-name="@category.Name.ToLower()">
                                            <span>@category.Name</span>
                                            <span class="count">@itemCount</span>
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                    
                    <!-- Price Filter -->
                    <div class="sidebar-block">
                        <h4>Khoảng Giá</h4>
                        <div class="price-slider">
                            <input type="range" class="form-range" min="0" max="5000000" step="100000" id="priceRange">
                            <div class="price-range mt-2">
                                <input type="text" class="price-input form-control" id="minPrice" placeholder="Min">
                                <span class="price-separator">-</span>
                                <input type="text" class="price-input form-control" id="maxPrice" placeholder="Max">
                            </div>
                            <button class="btn btn-sm btn-dark w-100 mt-3" id="applyPriceFilter">Áp dụng</button>
                        </div>
                    </div>
                    
                    <!-- Availability Filter -->
                    <div class="sidebar-block">
                        <h4>Trạng thái</h4>
                        <div class="sidebar-filter-item">
                            <div class="form-check">
                                <input class="form-check-input filter-checkbox" type="checkbox" id="inStock" value="inStock">
                                <label class="form-check-label" for="inStock">
                                    <span>Còn hàng</span>
                                    <span class="count">@Model.Count(p => p.Stock > 0)</span>
                                </label>
                            </div>
                        </div>
                        <div class="sidebar-filter-item">
                            <div class="form-check">
                                <input class="form-check-input filter-checkbox" type="checkbox" id="outOfStock" value="outOfStock">
                                <label class="form-check-label" for="outOfStock">
                                    <span>Hết hàng</span>
                                    <span class="count">@Model.Count(p => p.Stock == 0)</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Reset Filters -->
                    <a href="javascript:void(0)" class="filter-clear" id="clearFilters">
                        <i class="fas fa-times-circle me-2"></i> Xóa tất cả bộ lọc
                    </a>
                </div>
            </div>
            
            <!-- Products Content -->
            <div class="products-content">
                <!-- The filter tags now for mobile view only -->
                <div class="filter-tags d-md-none mb-3" id="categoryFilters">
                    <div class="filter-tag active" data-category="all">
                        <span>Tất cả</span>
                        <span class="count">(@Model.Count())</span>
                    </div>
            
                    @foreach (var item in Model.Where(p => p.Category != null).Select(p => p.Category.Name).Distinct())
                    {
                        if (item != null)
                        {
                            var itemCount = Model.Count(p => p.Category?.Name == item);
                            <div class="filter-tag" data-category="@item.ToLower()">
                                <span>@item</span>
                                <span class="count">(@itemCount)</span>
                            </div>
                        }
                    }
                </div>

                <!-- Products Grid -->
                <div class="products-grid" id="productsContainer">
                    @foreach (var product in Model)
                    {
                        <div class="product-card" 
                             data-name="@product.Name.ToLower()" 
                             data-category="@(product.Category?.Name?.ToLower() ?? "")" 
                             data-price="@product.Price"
                             data-stock="@product.Stock">
                            <div class="product-image">
                                @{
                                    var primaryImage = product.ProductImages?.FirstOrDefault(img => img.IsPrimary == true);
                                    var imageUrl = primaryImage?.ImageUrl ?? "/images/no-image.jpg";
                                }
                                <img src="@imageUrl" alt="@product.Name">
                                
                                <!-- Badges -->
                                <div class="product-badge badge-new">Mới</div>
                                
                                <!-- Wishlist -->
                                <div class="product-wishlist">
                                    <i class="far fa-heart"></i>
                                </div>
                            </div>
                            
                            <div class="product-info">
                                <div class="product-category">@(product.Category?.Name ?? "Chưa phân loại")</div>
                                <h3 class="product-title">
                                    <a asp-action="Details" asp-route-id="@product.ProductId">@product.Name</a>
                                </h3>
                                <div class="product-rating">
                                    @{
                                        // Calculate average rating from the reviews
                                        var avgRating = product.Reviews?.Any() == true ? product.Reviews.Average(r => r.Rating) : 0;
                                        var ratingCount = product.Reviews?.Count() ?? 0;
                                        var fullStars = (int)Math.Floor(avgRating);
                                        var halfStar = avgRating - fullStars >= 0.5;
                                        var emptyStars = 5 - fullStars - (halfStar ? 1 : 0);
                                    }
                                    <div class="rating-stars">
                                        @for (int i = 0; i < fullStars; i++)
                                        {
                                            <i class="fas fa-star"></i>
                                        }
                                        @if (halfStar)
                                        {
                                            <i class="fas fa-star-half-alt"></i>
                                        }
                                        @for (int i = 0; i < emptyStars; i++)
                                        {
                                            <i class="far fa-star"></i>
                                        }
                                    </div>
                                    <span class="rating-text">(@(avgRating > 0 ? avgRating.ToString("0.0") : "0"))</span>
                                </div>
                                <p class="product-description">
                                    @(product.Description?.Length > 80
                                        ? product.Description.Substring(0, 77) + "..."
                                        : product.Description ?? "Chưa có mô tả cho sản phẩm này.")
                                </p>
                                <div class="product-footer">
                                    <div class="product-price">
                                        @(product.Price.ToString("N0"))₫
                                    </div>
                                    <a href="#" class="btn-cart add-to-cart" data-id="@product.ProductId" data-name="@product.Name">
                                        <i class="fas fa-shopping-cart"></i>
                                        Thêm vào giỏ
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                <div class="pagination-container">
                    <nav aria-label="Product navigation">
                        <ul class="pagination">
                            <li class="page-item disabled">
                                <a class="page-link" href="#" aria-label="Previous">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item">
                                <a class="page-link" href="#" aria-label="Next">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    }
</div>

<!-- Notification template -->
<div id="notification" class="notification">
    <div id="notification-icon" class="notification-icon">
        <i class="fas fa-check-circle"></i>
    </div>
    <div class="notification-content">
        <div id="notification-title" class="notification-title">Success</div>
        <p id="notification-message" class="notification-message">The item has been added to cart.</p>
    </div>
    <button id="notification-close" class="notification-close">×</button>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // View mode switching
            const gridViewBtn = document.getElementById('gridViewBtn');
            const listViewBtn = document.getElementById('listViewBtn');
            const productsContainer = document.getElementById('productsContainer');
            const productCards = document.querySelectorAll('.product-card');
            const originalTitle = document.title;

            if (gridViewBtn && listViewBtn && productsContainer) {
                gridViewBtn.addEventListener('click', function() {
                    productsContainer.classList.remove('products-list');
                    gridViewBtn.classList.add('active');
                    listViewBtn.classList.remove('active');
                    localStorage.setItem('productViewMode', 'grid');
                });

                listViewBtn.addEventListener('click', function() {
                    productsContainer.classList.add('products-list');
                    listViewBtn.classList.add('active');
                    gridViewBtn.classList.remove('active');
                    localStorage.setItem('productViewMode', 'list');
                });

                // Restore saved view mode
                const savedViewMode = localStorage.getItem('productViewMode');
                if (savedViewMode === 'list') {
                    listViewBtn.click();
                }
            }

            // Category filtering - Sidebar links
            const categoryLinks = document.querySelectorAll('.category-link');
            
            if (categoryLinks && productCards) {
                categoryLinks.forEach(link => {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        
                        // Remove active class from all links
                        categoryLinks.forEach(l => l.classList.remove('active'));
                        
                        // Add active class to clicked link
                        this.classList.add('active');
                        
                        const categoryId = this.dataset.categoryId;
                        const categoryName = this.dataset.categoryName || 'all';
                        
                        // Apply all filters 
                        applyAllFilters();
                        
                        // Update browser URL without reloading page (for bookmarking)
                        const url = new URL(window.location.href);
                        if (categoryId == 0) {
                            url.searchParams.delete('categoryId');
                        } else {
                            url.searchParams.set('categoryId', categoryId);
                        }
                        window.history.pushState({}, '', url);
                        
                        // Update mobile view filter tags to match selection
                        if (categoryId == 0) {
                            document.querySelectorAll('#categoryFilters .filter-tag').forEach(tag => {
                                tag.classList.toggle('active', tag.dataset.category === 'all');
                            });
                        } else {
                            document.querySelectorAll('#categoryFilters .filter-tag').forEach(tag => {
                                tag.classList.toggle('active', tag.dataset.category === categoryName);
                            });
                        }
                        
                        // Update page title based on category selection
                        if (categoryId != 0) {
                            const categoryText = this.querySelector('span').textContent;
                            document.title = categoryText + ' - ' + originalTitle;
                        } else {
                            document.title = originalTitle;
                        }
                    });
                });
            }

            // Mobile category filtering
            const categoryFilters = document.querySelectorAll('#categoryFilters .filter-tag');
            
            categoryFilters.forEach(filter => {
                filter.addEventListener('click', function() {
                    const categoryName = this.dataset.category;
                    
                    if (categoryName === 'all') {
                        // Find and click the "All Products" link in sidebar
                        document.querySelector('.category-link[data-category-id="0"]').click();
                    } else {
                        // Find and click the matching category link in sidebar
                        const matchingLink = Array.from(document.querySelectorAll('.category-link')).find(
                            link => link.dataset.categoryName === categoryName
                        );
                        if (matchingLink) matchingLink.click();
                    }
                });
            });

            // Combine all filters in one function
            function applyAllFilters() {
                // Get all filter values
                const activeLink = document.querySelector('.category-link.active');
                const categoryId = activeLink ? activeLink.dataset.categoryId : 0;
                const categoryName = categoryId == 0 ? 'all' : activeLink.dataset.categoryName;
                const searchTerm = document.getElementById('searchInput').value.toLowerCase().trim();
                const minPriceValue = document.getElementById('minPrice').value.replace(/[^0-9]/g, '');
                const maxPriceValue = document.getElementById('maxPrice').value.replace(/[^0-9]/g, '');
                const minPrice = minPriceValue ? parseInt(minPriceValue) : 0;
                const maxPrice = maxPriceValue ? parseInt(maxPriceValue) : Number.MAX_SAFE_INTEGER;
                const inStockChecked = document.getElementById('inStock').checked;
                const outOfStockChecked = document.getElementById('outOfStock').checked;
                
                // Apply all filters at once
                let visibleCount = 0;
                productCards.forEach(card => {
                    // Category filter
                    const matchesCategory = categoryId == 0 || card.dataset.category === categoryName;
                    
                    // Search filter
                    const productName = card.dataset.name;
                    const productCategory = card.dataset.category;
                    const productDescription = card.querySelector('.product-description').textContent.toLowerCase();
                    const matchesSearch = !searchTerm || 
                                        productName.includes(searchTerm) || 
                                        productCategory.includes(searchTerm) || 
                                        productDescription.includes(searchTerm);
                    
                    // Price filter
                    const price = parseInt(card.dataset.price);
                    const matchesPrice = price >= minPrice && price <= maxPrice;
                    
                    // Stock filter
                    const stock = parseInt(card.dataset.stock) || 0;
                    const matchesStock = (!inStockChecked && !outOfStockChecked) || 
                                        (inStockChecked && stock > 0) || 
                                        (outOfStockChecked && stock === 0);
                    
                    // Show only if it matches ALL filters
                    if (matchesCategory && matchesSearch && matchesPrice && matchesStock) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });
                
                // Update products count
                updateProductCount(visibleCount);
                
                return visibleCount;
            }

            // Search functionality
            const searchInput = document.getElementById('searchInput');

            if (searchInput) {
                // Use debounce for better performance
                let searchTimer;
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(() => {
                        applyAllFilters();
                    }, 300);
                });
            }

            // Update products count in toolbar
            function updateProductCount(count) {
                const countStrong = document.querySelector('.products-count strong');
                const countBadge = document.querySelector('.products-count-badge');
                
                if (countStrong) countStrong.textContent = count;
                if (countBadge) countBadge.textContent = count;
            }

            // Sorting functionality
            const sortSelect = document.getElementById('sortProducts');

            if (sortSelect && productCards.length) {
                sortSelect.addEventListener('change', function() {
                    const sortValue = this.value;
                    const productsArray = Array.from(productCards).filter(card => card.style.display !== 'none');

                    productsArray.sort((a, b) => {
                        const nameA = a.dataset.name;
                        const nameB = b.dataset.name;
                        const priceA = parseFloat(a.dataset.price);
                        const priceB = parseFloat(b.dataset.price);

                        switch(sortValue) {
                            case 'name_asc':
                                return nameA.localeCompare(nameB);
                            case 'name_desc':
                                return nameB.localeCompare(nameA);
                            case 'price_asc':
                                return priceA - priceB;
                            case 'price_desc':
                                return priceB - priceA;
                            default:
                                return 0;
                        }
                    });

                    // Animation for sorting
                    productsContainer.classList.add('sorting');
                    
                    // Re-append only visible products in new order with delay for animation
                    setTimeout(() => {
                        // First, keep track of all hidden products
                        const hiddenProducts = Array.from(productCards).filter(card => card.style.display === 'none');
                        
                        // Then append sorted visible products
                        productsArray.forEach(card => productsContainer.appendChild(card));
                        
                        // Finally append hidden products so they stay at the end
                        hiddenProducts.forEach(card => productsContainer.appendChild(card));
                        
                        productsContainer.classList.remove('sorting');
                    }, 200);
                });
            }

            // Price range slider functionality
            const priceRange = document.getElementById('priceRange');
            const minPrice = document.getElementById('minPrice');
            const maxPrice = document.getElementById('maxPrice');
            const applyPriceFilter = document.getElementById('applyPriceFilter');
            
            if (priceRange && minPrice && maxPrice && applyPriceFilter) {
                priceRange.addEventListener('input', function() {
                    const value = this.value;
                    maxPrice.value = parseInt(value).toLocaleString('vi-VN');
                });
                
                applyPriceFilter.addEventListener('click', function() {
                    applyAllFilters();
                });
            }
            
            // Availability filter functionality
            const availabilityCheckboxes = document.querySelectorAll('.filter-checkbox');
            
            availabilityCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    applyAllFilters();
                });
            });

            // Clear all filters
            document.getElementById('clearFilters')?.addEventListener('click', function(e) {
                e.preventDefault();
                
                // Reset category filter
                document.querySelector('.category-link[data-category-id="0"]')?.classList.add('active');
                document.querySelectorAll('.category-link[data-category-id]:not([data-category-id="0"])').forEach(link => {
                    link.classList.remove('active');
                });
                
                // Reset category filters in mobile view
                document.querySelectorAll('#categoryFilters .filter-tag').forEach(tag => {
                    tag.classList.toggle('active', tag.dataset.category === 'all');
                });
                
                // Reset price filter
                if (minPrice) minPrice.value = '';
                if (maxPrice) maxPrice.value = '';
                if (priceRange) priceRange.value = priceRange.max;
                
                // Reset stock filters
                if (document.getElementById('inStock')) document.getElementById('inStock').checked = false;
                if (document.getElementById('outOfStock')) document.getElementById('outOfStock').checked = false;
                
                // Reset search
                if (searchInput) searchInput.value = '';
                
                // Reset sorting
                if (sortSelect) sortSelect.value = 'default';
                
                // Reset product display (show all)
                productCards.forEach(card => {
                    card.style.display = '';
                });
                
                // Reset URL
                window.history.pushState({}, '', window.location.pathname);
                
                // Update count
                updateProductCount(productCards.length);
                
                // Show notification
                showNotification('Đã xóa tất cả bộ lọc', 'success');
            });

            // Filter toggle for mobile
            const filterToggle = document.getElementById('filterToggle');
            const sidebarContent = document.getElementById('sidebarContent');
            
            if (filterToggle && sidebarContent) {
                filterToggle.addEventListener('click', function() {
                    sidebarContent.classList.toggle('show');
                    const isExpanded = sidebarContent.classList.contains('show');
                    this.innerHTML = isExpanded 
                        ? '<i class="fas fa-times me-2"></i> Đóng bộ lọc'
                        : '<i class="fas fa-filter me-2"></i> Lọc Sản Phẩm';
                });
            }

            // Wishlist toggle
            document.querySelectorAll('.product-wishlist').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const icon = this.querySelector('i');
                    let message = '';
                    
                    if (icon.classList.contains('far')) {
                        icon.classList.remove('far');
                        icon.classList.add('fas');
                        this.style.background = '#f8d7da';
                        icon.style.color = '#dc3545';
                        message = 'Đã thêm sản phẩm vào danh sách yêu thích';
                    } else {
                        icon.classList.remove('fas');
                        icon.classList.add('far');
                        this.style.background = '#ffffff';
                        icon.style.color = '';
                        message = 'Đã xóa sản phẩm khỏi danh sách yêu thích';
                    }
                    
                    // Show notification
                    showNotification(message, icon.classList.contains('fas') ? 'success' : 'info');
                });
            });
            
            // Notification functionality
            const notification = document.getElementById('notification');
            const notificationIcon = document.getElementById('notification-icon');
            const notificationTitle = document.getElementById('notification-title');
            const notificationMessage = document.getElementById('notification-message');
            const notificationClose = document.getElementById('notification-close');
            let notificationTimeout;
            
            window.showNotification = function(message, type = 'success') {
                // Clear existing timeout if any
                if (notificationTimeout) {
                    clearTimeout(notificationTimeout);
                }
                
                // Update notification content
                notificationIcon.className = `notification-icon ${type}`;
                notificationIcon.innerHTML = type === 'success' 
                    ? '<i class="fas fa-check-circle"></i>' 
                    : '<i class="fas fa-info-circle"></i>';
                    
                notificationTitle.textContent = type === 'success' ? 'Thành công' : 'Thông báo';
                notificationMessage.textContent = message;
                
                // Show notification
                notification.classList.add('show');
                
                // Auto hide after 3 seconds
                notificationTimeout = setTimeout(() => {
                    notification.classList.remove('show');
                }, 3000);
            }
            
            // Close notification on click
            notificationClose.addEventListener('click', function() {
                notification.classList.remove('show');
                if (notificationTimeout) {
                    clearTimeout(notificationTimeout);
                }
            });

            // Smooth scroll to products
            document.querySelector('a[href="#products"]')?.addEventListener('click', function(e) {
                e.preventDefault();
                productsContainer.scrollIntoView({
                    behavior: 'smooth'
                });
            });
            
            // Animation for product cards on load
            setTimeout(() => {
                productCards.forEach(card => {
                    card.style.opacity = '1';
                });
            }, 100);
            
            // Add to cart functionality
            document.querySelectorAll('.add-to-cart').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    const productId = this.dataset.id;
                    const productName = this.dataset.name;
        
                    // Thêm hiệu ứng loading khi nhấn nút
                    const originalText = this.innerHTML;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang thêm...';
                    this.disabled = true;

                    // Gọi API thêm vào giỏ hàng bằng fetch API
                    fetch(`/Cart/AddToCartAjax?productId=${productId}&quantity=1`)
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Network response was not ok');
                            }
                            return response.json();
                        })
                        .then(data => {
                            // Khôi phục nút
                            this.innerHTML = originalText;
                            this.disabled = false;
                
                            if (data.success) {
                                // Cập nhật số lượng giỏ hàng trên navbar
                                document.querySelectorAll('.cart-count').forEach(badge => {
                                    badge.textContent = data.cartCount;
                                    badge.style.display = 'block';
                                });
                    
                                // Hiển thị thông báo thành công
                                showNotification(data.message || `Đã thêm "${productName}" vào giỏ hàng`, 'success');
                            } else {
                                // Hiển thị thông báo lỗi
                                showNotification(data.message || 'Không thể thêm vào giỏ hàng', 'error');
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            this.innerHTML = originalText;
                            this.disabled = false;
                            showNotification('Đã xảy ra lỗi khi thêm vào giỏ hàng', 'error');
                        });
                });
            });
            
            // Apply filters on page load (in case there are URL parameters)
            setTimeout(() => {
                const urlParams = new URLSearchParams(window.location.search);
                if (urlParams.has('categoryId')) {
                    const categoryId = urlParams.get('categoryId');
                    const categoryLink = document.querySelector(`.category-link[data-category-id="${categoryId}"]`);
                    if (categoryLink) {
                        categoryLink.click();
                    }
                }
            }, 200);
        });
    </script>
}