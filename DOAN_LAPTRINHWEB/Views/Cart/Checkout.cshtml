@model CheckoutViewModel
@{
    ViewData["Title"] = "Thanh Toán";
}

<section class="container py-5">
    <h1 class="mb-4">Thanh toán</h1>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Checkout" method="post">
        <!-- Hidden fields for required model properties -->
        <input type="hidden" asp-for="UserId" />

        <!-- The form content remains the same -->
        <div class="row">
            <div class="col-lg-8">
                <!-- Thông tin giao hàng -->
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-4">Thông tin giao hàng</h5>

                        <div class="mb-3">
                            <label asp-for="Address.FullName" class="form-label">Họ và tên</label>
                            <input asp-for="Address.FullName" class="form-control" />
                            <span asp-validation-for="Address.FullName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Address.Phone" class="form-label">Số điện thoại</label>
                                <input asp-for="Address.Phone" class="form-control" />
                                <span asp-validation-for="Address.Phone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control" value="@Model.User?.Email" readonly />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address.Street" class="form-label">Địa chỉ</label>
                            <input asp-for="Address.Street" class="form-control" placeholder="Số nhà, tên đường" />
                            <span asp-validation-for="Address.Street" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Address.City" class="form-label">Thành phố</label>
                                <input asp-for="Address.City" class="form-control" />
                                <span asp-validation-for="Address.City" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Address.State" class="form-label">Tỉnh/Thành</label>
                                <input asp-for="Address.State" class="form-control" />
                                <span asp-validation-for="Address.State" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Address.PostalCode" class="form-label">Mã bưu điện</label>
                                <input asp-for="Address.PostalCode" class="form-control" />
                                <span asp-validation-for="Address.PostalCode" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address.Country" class="form-label">Quốc gia</label>
                            <input asp-for="Address.Country" class="form-control" value="Việt Nam" />
                            <span asp-validation-for="Address.Country" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Phương thức thanh toán -->
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-4">Phương thức thanh toán</h5>

                        <div class="form-check mb-3">
                            <input class="form-check-input payment-method-radio" type="radio" asp-for="PaymentMethod" id="payment-cod" value="COD" checked>
                            <label class="form-check-label d-flex align-items-center" for="payment-cod">
                                <span class="me-2"><i class="fas fa-money-bill-wave"></i></span>
                                Thanh toán khi nhận hàng (COD)
                            </label>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input payment-method-radio" type="radio" asp-for="PaymentMethod" id="payment-bank" value="Banking">
                            <label class="form-check-label d-flex align-items-center" for="payment-bank">
                                <span class="me-2"><i class="fas fa-university"></i></span>
                                Chuyển khoản ngân hàng
                            </label>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input payment-method-radio" type="radio" asp-for="PaymentMethod" id="payment-momo" value="Momo">
                            <label class="form-check-label d-flex align-items-center" for="payment-momo">
                                <span class="me-2"><i class="fas fa-wallet"></i></span>
                                Ví Momo
                            </label>
                        </div>

                        <div id="bank-info" class="mt-3 p-3 bg-light rounded" style="display: none;">
                            <h6>Thông tin chuyển khoản:</h6>
                            <p class="mb-1">Ngân hàng: <strong>VIETCOMBANK</strong></p>
                            <p class="mb-1">Số tài khoản: <strong>0123456789</strong></p>
                            <p class="mb-1">Chủ tài khoản: <strong>CÔNG TY TNHH HOME STYLES</strong></p>
                            <p class="mb-0">Nội dung: <strong>Thanh toán đơn hàng [Họ tên]</strong></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Tóm tắt đơn hàng -->
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-4">Đơn hàng của bạn</h5>

                        <div class="order-summary">
                            @foreach (var item in Model.Cart.Items)
                            {
                                <div class="d-flex justify-content-between mb-2">
                                    <span>@item.ProductName × @item.Quantity</span>
                                    <span>@item.Subtotal.ToString("N0")₫</span>
                                </div>
                            }
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính</span>
                            <span>@Model.Cart.TotalAmount.ToString("N0")₫</span>
                        </div>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Phí vận chuyển</span>
                            <span>Miễn phí</span>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between mb-4">
                            <span class="fw-bold">Tổng cộng</span>
                            <span class="fw-bold fs-5">@Model.Cart.TotalAmount.ToString("N0")₫</span>
                        </div>

                        <button type="submit" class="btn btn-dark w-100">Đặt hàng</button>

                        <div class="mt-3 text-center">
                            <small class="text-muted">
                                Bằng cách đặt hàng, bạn đồng ý với
                                <a href="#">Điều khoản dịch vụ</a> và
                                <a href="#">Chính sách bảo mật</a> của chúng tôi.
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).ready(function() {
            // Hiển thị thông tin ngân hàng khi chọn phương thức chuyển khoản
            $('.payment-method-radio').change(function() {
                if ($(this).val() === 'Banking') {
                    $('#bank-info').slideDown();
                } else {
                    $('#bank-info').slideUp();
                }
            });

            // Show bank info initially if Banking is selected
            if ($('#payment-bank').is(':checked')) {
                $('#bank-info').show();
            }

            // Prevent double form submission and show loading indicator
            $('form').submit(function() {
                var submitButton = $(this).find('button[type="submit"]');
                submitButton.prop('disabled', true);
                submitButton.html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...');

                // Re-enable button after 10 seconds in case of errors
                setTimeout(function() {
                    submitButton.prop('disabled', false);
                    submitButton.html('Đặt hàng');
                }, 10000);

                return true;
            });
        });
    </script>
}