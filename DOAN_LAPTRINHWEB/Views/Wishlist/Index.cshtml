@model IEnumerable<DOAN_LAPTRINHWEB.Models.Wishlist>
@{
    ViewData["Title"] = "Danh sách yêu thích";
}

<div class="container my-5">
    @Html.AntiForgeryToken()
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">
                    <i class="fas fa-heart text-danger me-2"></i>
                    Danh sách yêu thích
                </h2>
                <span class="badge bg-primary fs-6">@Model.Count() sản phẩm</span>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-heart-broken text-muted" style="font-size: 4rem;"></i>
                    <h4 class="mt-3 text-muted">Danh sách yêu thích trống</h4>
                    <p class="text-muted">Hãy thêm những sản phẩm bạn yêu thích để dễ dàng tìm lại sau này.</p>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-primary">
                        <i class="fas fa-shopping-bag me-2"></i>Khám phá sản phẩm
                    </a>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var item in Model)
                    {
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-4" id="wishlist-item-@item.ProductId">
                            <div class="card h-100 shadow-sm">
                                <div class="position-relative">
                                    @if (item.Product.ProductImages.Any())
                                    {
                                        <img src="@item.Product.ProductImages.First().ImageUrl"
                                             class="card-img-top"
                                             alt="@item.Product.Name"
                                             style="height: 200px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="card-img-top d-flex align-items-center justify-content-center bg-light"
                                             style="height: 200px;">
                                            <i class="fas fa-image text-muted fa-3x"></i>
                                        </div>
                                    }

                                    <button class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2 remove-wishlist-btn"
                                            data-product-id="@item.ProductId"
                                            title="Xóa khỏi yêu thích">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>

                                <div class="card-body d-flex flex-column">
                                    <h6 class="card-title">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId"
                                           class="text-decoration-none text-dark">
                                            @item.Product.Name
                                        </a>
                                    </h6>

                                    <p class="card-text text-muted small mb-2">
                                        <i class="fas fa-tag me-1"></i>@item.Product.Category?.Name
                                    </p>

                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="h5 text-primary mb-0">
                                                @item.Product.Price.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))
                                            </span>
                                        </div>


                                        <div class="d-grid gap-2">
                                            <button class="btn btn-primary btn-sm add-to-cart-btn"
                                                    data-product-id="@item.ProductId">
                                                <i class="fas fa-shopping-cart me-1"></i>Thêm vào giỏ
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="card-footer bg-transparent border-0 pt-0">
                                    <small class="text-muted">
                                        <i class="fas fa-clock me-1"></i>
                                        Đã thêm: @item.CreatedAt.ToString("dd/MM/yyyy")
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Xóa khỏi wishlist
            $('.remove-wishlist-btn').click(function() {
                const productId = $(this).data('product-id');
                const button = $(this);

                if (confirm('Bạn có chắc muốn xóa sản phẩm này khỏi danh sách yêu thích?')) {
                    $.ajax({
                        url: '/Wishlist/RemoveFromWishlist',
                        type: 'POST',
                        data: {
                            productId: productId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                $('#wishlist-item-' + productId).fadeOut(300, function() {
                                    $(this).remove();

                                    // Cập nhật số lượng
                                    const currentCount = parseInt($('.badge').text());
                                    $('.badge').text((currentCount - 1) + ' sản phẩm');

                                    // Kiểm tra nếu không còn item nào
                                    if ($('.row .col-lg-3').length === 0) {
                                        location.reload();
                                    }
                                });

                                showNotification(response.message, 'success');
                            } else {
                                showNotification(response.message, 'error');
                            }
                        },
                        error: function() {
                            showNotification('Có lỗi xảy ra. Vui lòng thử lại.', 'error');
                        }
                    });
                }
            });

            // Thêm vào giỏ hàng
            $('.add-to-cart-btn').click(function() {
                const productId = $(this).data('product-id');
                const button = $(this);
                const originalText = button.html();

                // Hiệu ứng loading
                button.html('<i class="fas fa-spinner fa-spin me-1"></i>Đang thêm...').prop('disabled', true);

                $.ajax({
                    url: '/Cart/AddToCartAjax',
                    type: 'GET',
                    data: {
                        productId: productId,
                        quantity: 1
                    },
                    success: function(response) {
                        // Khôi phục nút
                        button.html(originalText).prop('disabled', false);

                        if (response.success) {
                            // Cập nhật số lượng giỏ hàng ngay lập tức
                            updateCartCount(response.cartCount);

                            // Hiệu ứng thành công cho nút
                            button.html('<i class="fas fa-check me-1"></i>Đã thêm')
                                  .removeClass('btn-primary')
                                  .addClass('btn-success');

                            // Hiển thị thông báo thành công
                            showNotification(response.message || 'Đã thêm vào giỏ hàng!', 'success');

                            // Khôi phục nút sau 2 giây
                            setTimeout(() => {
                                button.html(originalText)
                                      .removeClass('btn-success')
                                      .addClass('btn-primary');
                            }, 2000);
                        } else {
                            showNotification(response.message || 'Không thể thêm vào giỏ hàng', 'error');
                        }
                    },
                    error: function() {
                        button.html(originalText).prop('disabled', false);
                        showNotification('Có lỗi xảy ra. Vui lòng thử lại.', 'error');
                    }
                });
            });
        });

        // Hàm cập nhật số lượng giỏ hàng
        function updateCartCount(count) {
            $('.cart-count, .cart-badge, .cart-counter, [data-cart-count]').each(function() {
                $(this).text(count);
                if (count > 0) {
                    $(this).show().removeClass('d-none');

                    // Thêm hiệu ứng bounce
                    $(this).addClass('animate-bounce');
                    setTimeout(() => {
                        $(this).removeClass('animate-bounce');
                    }, 600);
                } else {
                    $(this).hide().addClass('d-none');
                }
            });
        }

        // Hàm hiển thị notification giống các trang khác
        function showNotification(message, type = 'success') {
            // Tạo notification element nếu chưa có
            let notification = document.getElementById('notification');
            if (!notification) {
                notification = document.createElement('div');
                notification.id = 'notification';
                notification.className = 'notification';
                notification.innerHTML = `
                    <div id="notification-icon" class="notification-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="notification-content">
                        <div id="notification-title" class="notification-title">Success</div>
                        <p id="notification-message" class="notification-message">Message</p>
                    </div>
                    <button id="notification-close" class="notification-close">×</button>
                `;
                document.body.appendChild(notification);

                // Add close event
                document.getElementById('notification-close').addEventListener('click', function() {
                    notification.classList.remove('show');
                });
            }

            const notificationIcon = document.getElementById('notification-icon');
            const notificationTitle = document.getElementById('notification-title');
            const notificationMessage = document.getElementById('notification-message');

            // Clear existing timeout if any
            if (window.notificationTimeout) {
                clearTimeout(window.notificationTimeout);
            }

            // Update notification content
            notificationIcon.className = `notification-icon ${type}`;
            notificationIcon.innerHTML = type === 'success'
                ? '<i class="fas fa-check-circle"></i>'
                : type === 'error'
                ? '<i class="fas fa-exclamation-circle"></i>'
                : '<i class="fas fa-info-circle"></i>';

            notificationTitle.textContent = type === 'success' ? 'Thành công' : type === 'error' ? 'Lỗi' : 'Thông báo';
            notificationMessage.textContent = message;

            // Show notification
            notification.classList.add('show');

            // Auto hide after 3 seconds
            window.notificationTimeout = setTimeout(() => {
                notification.classList.remove('show');
            }, 3000);
        }
    </script>

    <style>
        /* Notification styles giống các trang khác */
        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            background: #ffffff;
            border-radius: 8px;
            padding: 15px 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.15);
            display: flex;
            align-items: center;
            gap: 15px;
            z-index: 1050;
            transform: translateX(120%);
            transition: transform 0.3s ease-out;
            min-width: 300px;
        }

            .notification.show {
                transform: translateX(0);
            }

        .notification-icon {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

            .notification-icon.success {
                color: #198754;
                background-color: rgba(25, 135, 84, 0.1);
            }

            .notification-icon.error {
                color: #dc3545;
                background-color: rgba(220, 53, 69, 0.1);
            }

        .notification-content {
            flex-grow: 1;
        }

        .notification-title {
            font-weight: 600;
            margin-bottom: 5px;
            font-size: 0.95rem;
        }

        .notification-message {
            font-size: 0.85rem;
            color: #6c757d;
            margin: 0;
        }

        .notification-close {
            background: none;
            border: none;
            font-size: 1.2rem;
            color: #6c757d;
            cursor: pointer;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Animation cho cart count update */
        .animate-bounce {
            animation: bounce 0.6s ease-in-out;
        }

        @@keyframes bounce {
            0%, 20%, 60%, 100%

        {
            transform: translateY(0);
        }

        40% {
            transform: translateY(-10px);
        }

        80% {
            transform: translateY(-5px);
        }

        }

        /* Hiệu ứng cho button success */
        .btn-success {
            transition: all 0.3s ease;
        }
    </style>
}


