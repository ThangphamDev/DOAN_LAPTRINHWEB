@using DOAN_LAPTRINHWEB.Extensions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HomeStyle - Đồ Decor Phòng</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Toastr CSS for notifications -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
</head>
<body class="bg-light">
    <header class="header-fixed">
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm border-bottom">
            <div class="container-fluid px-4 px-lg-5">
                <!-- Logo -->
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="brand-name">HomeStyle</span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link px-3 active" asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Products" asp-action="Index">Sản Phẩm</a>
                        </li>
                        <li class="nav-item dropdown category-dropdown-wrapper">
                            <a class="nav-link dropdown-toggle px-3" href="#">
                                Danh Mục
                            </a>
                            <div class="category-dropdown">
                                <div class="category-dropdown-inner">
                                    @{
                                        // Lấy danh sách danh mục từ database
                                        var dbContext = (HomeStylesDbContext)Context.RequestServices.GetService(typeof(HomeStylesDbContext));
                                        var categories = dbContext?.Categories.ToList() ?? new List<Category>();
                                    }
                                    @foreach (var category in categories)
                                    {
                                        <a class="dropdown-item" asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.CategoryId">
                                            @category.Name
                                        </a>
                                    }
                                </div>
                            </div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" href="#">Ý Tưởng Decor</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" href="#">Liên Hệ</a>
                        </li>
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="fas fa-tachometer-alt me-1"></i> Quản trị Admin
                                </a>
                            </li>
                        }
                    </ul>


                    <!-- Actions -->
                    <div class="nav-actions d-flex align-items-center gap-3">
                        <button class="btn btn-link text-dark p-0" type="button">
                            <i class="fas fa-search"></i>
                        </button>

                        <a asp-controller="Cart" asp-action="Index" class="btn btn-dark position-relative rounded-pill px-3">
                            <i class="fas fa-shopping-cart me-2"></i>
                            <span>Giỏ hàng</span>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger cart-count" style="font-size: 0.85rem; min-width: 1.5em;">
                                @{
                                    var cartCount = 0;
                                    if (Context.Session.TryGetString("Cart", out var cartJson) && !string.IsNullOrEmpty(cartJson))
                                    {
                                        try
                                        {
                                            var cart = Newtonsoft.Json.JsonConvert.DeserializeObject<DOAN_LAPTRINHWEB.Models.Cart>(cartJson);
                                            if (cart?.Items != null)
                                            {
                                                cartCount = cart.Items.Sum(i => i.Quantity);
                                            }
                                        }
                                        catch { /* Ignore deserialization errors */ }
                                    }
                                }
                                @if (cartCount > 0)
                                {
                                    @cartCount
                                }
                            </span>
                        </a>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="py-4">
        <div class="container-fluid px-4 px-lg-5">
            @RenderBody()
        </div>
    </main>

    <!-- Footer section remains the same -->
    <footer class="bg-dark text-white py-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <h5 class="brand-name text-white mb-4">HomeStyle</h5>
                    <p>Biến không gian sống của bạn trở nên đẹp hơn với các sản phẩm decor độc đáo và tinh tế</p>
                    <div class="social-icons mt-4">
                        <a href="#" class="text-white me-3"><i class="fab fa-facebook-f fa-lg"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-instagram fa-lg"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-pinterest-p fa-lg"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-youtube fa-lg"></i></a>
                    </div>
                    <!-- Newsletter Section with Smaller Font Size -->
                    <div class="mt-4">
                        <h2 class="mb-4 fs-5">Đăng ký nhận thông tin</h2> <!-- Reduced from h2 default to fs-5 -->
                        <p class="mb-4 text-small">Nhận thông tin về sản phẩm mới, khuyến mãi và ý tưởng trang trí từ chúng tôi</p> <!-- Added text-small class -->
                        <form class="newsletter-form">
                            <div class="input-group mb-3">
                                <input type="email" class="form-control" placeholder="Email của bạn" aria-label="Email của bạn" style="font-size: 0.9rem;"> <!-- Reduced font size -->
                                <button class="btn btn-light" type="submit" style="font-size: 0.9rem;">Đăng ký</button> <!-- Reduced font size -->
                            </div>
                        </form>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 mb-4 mb-md-0">
                    <h5 class="mb-4">Thông tin</h5>
                    <ul class="list-unstyled footer-links">
                        <li><a href="#">Về chúng tôi</a></li>
                        <li><a href="#">Điều khoản sử dụng</a></li>
                        <li><a href="#">Chính sách bảo mật</a></li>
                        <li><a href="#">Blog</a></li>
                        <li><a href="#">Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-4 mb-4 mb-md-0">
                    <h5 class="mb-4">Tài khoản</h5>
                    <ul class="list-unstyled footer-links">
                        <li><a href="#">Tài khoản của tôi</a></li>
                        <li><a href="#">Giỏ hàng</a></li>
                        <li><a href="#">Yêu thích</a></li>
                        <li><a href="#">Theo dõi đơn hàng</a></li>
                        <li><a href="#">Trợ giúp</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-4">
                    <h5 class="mb-4">Liên hệ</h5>
                    <div class="d-flex align-items-start mb-3">
                        <i class="fas fa-map-marker-alt mt-1 me-3"></i>
                        <p class="mb-0">Tầng 5, Tòa nhà Landmark, 208 Nguyễn Hữu Cảnh, Quận Bình Thạnh, TP.HCM</p>
                    </div>
                    <div class="d-flex align-items-start mb-3">
                        <i class="fas fa-phone-alt mt-1 me-3"></i>
                        <p class="mb-0">+84 28 3827 9999</p>
                    </div>
                    <div class="d-flex align-items-start">
                        <i class="fas fa-envelope mt-1 me-3"></i>
                        <p class="mb-0">info@homestyling.vn</p>
                    </div>
                </div>
            </div>
            <hr class="my-4 bg-secondary">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <p class="mb-0">© 2025 HomeStyle. Tất cả quyền được bảo lưu.</p>
                </div>
                <div class="col-md-6 text-center text-md-end mt-3 mt-md-0">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/5/5e/Visa_Inc._logo.svg/2560px-Visa_Inc._logo.svg.png" alt="Visa" height="30" class="me-3">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/2a/Mastercard-logo.svg/1280px-Mastercard-logo.svg.png" alt="Mastercard" height="30" class="me-3">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/b/b5/PayPal.svg/2560px-PayPal.svg.png" alt="PayPal" height="30">
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        // Global notification function
        window.showNotification = function(message, type) {
            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-right",
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "5000"
            };

            switch(type) {
                case 'success':
                    toastr.success(message);
                    break;
                case 'error':
                    toastr.error(message);
                    break;
                case 'warning':
                    toastr.warning(message);
                    break;
                default:
                    toastr.info(message);
            }
        };
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>