@using Microsoft.AspNetCore.Identity
@using DOAN_LAPTRINHWEB.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="d-flex align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var displayName = user?.FullName ?? UserManager.GetUserName(User);
        var avatarUrl = user?.AvatarUrl;

        <div class="dropdown hover-dropdown" id="customDropdown">
            <button type="button" class="btn btn-link text-dark dropdown-toggle px-0 me-2" id="userDropdownBtn">
                @if (!string.IsNullOrEmpty(avatarUrl))
                {
                    <img src="@Url.Content(avatarUrl)" alt="Avatar" class="rounded-circle me-1" style="width: 24px; height: 24px; object-fit: cover;">
                }
                else
                {
                    <i class="bi bi-person-circle me-1"></i>
                }
                <span class="me-1">Xin chào</span><span class="fw-medium">@displayName</span>
            </button>
            <ul class="dropdown-menu shadow-sm border-0" id="userDropdownMenu">
                <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-person-fill me-2"></i>Tài khoản của tôi</a></li>
                <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Orders"><i class="bi bi-box-seam-fill me-2"></i>Đơn hàng của tôi</a></li>
                <li><a class="dropdown-item" href="#"><i class="bi bi-heart-fill me-2"></i>Yêu thích</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                    </form>
                </li>
            </ul>
        </div>
    }
    else
    {
        <a class="nav-link btn btn-outline-dark rounded-pill px-3 me-2" id="login" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
        </a>
        <a class="nav-link btn btn-dark rounded-pill px-3 text-white" id="register" asp-area="Identity" asp-page="/Account/Register">
            Đăng ký
        </a>
    }
</div>