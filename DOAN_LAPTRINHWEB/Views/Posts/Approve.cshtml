@model DOAN_LAPTRINHWEB.Models.Post

@{
    ViewData["Title"] = "Duyệt bài viết";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<div class="container mt-5">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title"><strong>Tiêu đề:</strong> @Model.Title</h5>
            <p class="card-text"><strong>Nội dung:</strong> @Model.Content</p>
            <p class="card-text"><strong>Tác giả:</strong> @Model.User?.UserName</p>
            <p class="card-text"><strong>Loại:</strong> @Model.PostType?.Name</p>
            <p class="card-text"><strong>Ngày tạo:</strong> @Model.CreatedDate.ToString("dd/MM/yyyy")</p>
            <p class="card-text"><strong>URL hình ảnh:</strong> @Model.ImageUrls</p>
        </div>
    </div>

    <form asp-action="Approve" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3 mt-3">
            <label for="ApprovalStatus" class="form-label">Trạng thái duyệt</label>
            <select name="ApprovalStatus" class="form-select">
                <option value="Approved" selected="@(Model.ApprovalStatus == "Approved")">Chấp nhận</option>
                <option value="Rejected" selected="@(Model.ApprovalStatus == "Rejected")">Từ chối</option>
                <option value="Pending" selected="@(Model.ApprovalStatus == "Pending")">Chờ duyệt</option>
            </select>
        </div>
        <div class="mb-3">
            <label for="ApprovalComment" class="form-label">Ghi chú duyệt</label>
            <textarea name="ApprovalComment" class="form-control" rows="4">@Model.ApprovalComment</textarea>
        </div>
        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a asp-action="AllPosts" class="btn btn-secondary">Quay lại</a>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
}

