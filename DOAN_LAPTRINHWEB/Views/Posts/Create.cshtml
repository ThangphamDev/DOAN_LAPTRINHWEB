@model DOAN_LAPTRINHWEB.Models.CreatePostDto

@{
    ViewData["Title"] = "Tạo bài viết mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <form asp-action="Create" method="post" id="createPostForm" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label">Tiêu đề</label>
            <input asp-for="Title" class="form-control" required />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Content" class="form-label">Nội dung</label>
            <textarea asp-for="Content" class="form-control" rows="10" required></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label class="form-label">Ảnh đại diện cho bài viết</label>
            <div class="input-group">
                <input type="file" class="form-control" id="coverImageFile" name="CoverImageFile" accept="image/*" />
                <button class="btn btn-outline-secondary" type="button" id="uploadCoverBtn">
                    <i class="fas fa-upload"></i> Tải lên
                </button>
            </div>
            <small class="text-muted d-block mt-1">Kích thước tối đa: 5MB (JPG, PNG, GIF)</small>

            <div class="mt-3 d-none" id="coverImagePreview">
                <div class="card p-2 bg-light">
                    <div class="d-flex align-items-center">
                        <img src="" alt="Ảnh xem trước" class="img-thumbnail me-3" style="max-height: 100px; max-width: 150px;" id="previewImg" />
                        <div>
                            <h6 class="mb-1" id="previewFilename"></h6>
                            <button type="button" class="btn btn-sm btn-danger" id="removeCoverBtn">
                                <i class="fas fa-trash me-1"></i> Xóa
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <input asp-for="ImageUrls" type="hidden" id="imageUrlInput" />
            <span asp-validation-for="ImageUrls" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PostTypeId" class="form-label">Loại bài viết</label>
            <select asp-for="PostTypeId" class="form-select" required
                    asp-items="@(new SelectList(ViewData["PostTypes"] as List<DOAN_LAPTRINHWEB.Models.PostType>, "Id", "Name"))">
                <option value="">Chọn loại bài viết</option>
            </select>
            <span asp-validation-for="PostTypeId" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-2"></i> Tạo bài viết
            </button>
            <a asp-action="MyPosts" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i> Quay lại
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const fileInput = document.getElementById('coverImageFile');
            const imageUrlInput = document.getElementById('imageUrlInput');
            const previewContainer = document.getElementById('coverImagePreview');
            const previewImg = document.getElementById('previewImg');
            const previewFilename = document.getElementById('previewFilename');
            const removeBtn = document.getElementById('removeCoverBtn');
            const uploadBtn = document.getElementById('uploadCoverBtn');

            // Function to handle image upload
            function handleFileUpload() {
                const file = fileInput.files[0];
                if (!file) return;

                // Kiểm tra kích thước file (5MB)
                if (file.size > 5 * 1024 * 1024) {
                    alert('File quá lớn. Vui lòng chọn file nhỏ hơn 5MB.');
                    fileInput.value = '';
                    return;
                }

                // Kiểm tra loại file
                const fileType = file.type;
                if (!fileType.match('image.*')) {
                    alert('Vui lòng chọn file hình ảnh.');
                    fileInput.value = '';
                    return;
                }

                // Tạo form data để upload
                const formData = new FormData();
                formData.append('file', file);

                // Upload file
                fetch('/Posts/UploadImage', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.location) {
                        // Hiển thị ảnh xem trước
                        previewImg.src = data.location;
                        previewFilename.textContent = file.name;
                        previewContainer.classList.remove('d-none');

                        // Cập nhật giá trị vào input
                        imageUrlInput.value = data.location;

                        // Xóa file đã chọn
                        fileInput.value = '';
                    } else {
                        alert('Có lỗi xảy ra khi tải lên file');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Có lỗi xảy ra khi tải lên file');
                });
            }

            // Khi nhấn nút Upload
            uploadBtn.addEventListener('click', handleFileUpload);

            // Khi file input thay đổi, hiển thị preview ngay lập tức
            fileInput.addEventListener('change', function() {
                const file = this.files[0];
                if (file) {
                    // Hiển thị preview ngay lập tức
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        previewImg.src = e.target.result;
                        previewFilename.textContent = file.name;
                        previewContainer.classList.remove('d-none');
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Khi nhấn nút Remove
            removeBtn.addEventListener('click', function() {
                previewContainer.classList.add('d-none');
                previewImg.src = '';
                fileInput.value = '';
                imageUrlInput.value = '';
            });

            // Handle form submission
            const form = document.getElementById('createPostForm');
            form.addEventListener('submit', function(e) {
                // Validate required fields
                if (!form.querySelector('[name="Title"]').value.trim()) {
                    e.preventDefault();
                    alert('Vui lòng nhập tiêu đề bài viết');
                    return false;
                }

                if (!form.querySelector('[name="Content"]').value.trim()) {
                    e.preventDefault();
                    alert('Vui lòng nhập nội dung bài viết');
                    return false;
                }

                if (!form.querySelector('[name="PostTypeId"]').value) {
                    e.preventDefault();
                    alert('Vui lòng chọn loại bài viết');
                    return false;
                }

                return true;
            });
        });
    </script>
}
