@model IEnumerable<DOAN_LAPTRINHWEB.Models.Post>

@if (!Model.Any())
{
    <div class="alert alert-info">Không có bài viết nào.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Tiêu đề</th>
                <th>Ngày tạo</th>
                <th>Loại</th>
                <th>Trạng thái</th>
                <th></th> <!-- Thêm cột cho nút -->
            </tr>
        </thead>
        <tbody>
            @foreach (var post in Model)
            {
                var statusClass = post.ApprovalStatus switch
                {
                    "Approved" => "table-success",
                    "Rejected" => "table-danger",
                    "Pending" => "table-warning",
                    _ => ""
                };
                <tr class="@statusClass">
                    <td>@post.Title</td>
                    <td>@post.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@post.PostType?.Name</td>
                    <td>@post.ApprovalStatus</td>
                    <td>
                        <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-eye"></i> Chi tiết
                        </a>
                        <a asp-controller="Posts" asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-outline-primary me-1">
                            <i class="bi bi-pencil"></i> Sửa
                        </a>
                        <a asp-controller="Posts" asp-action="Delete" asp-route-id="@post.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i> Xoá
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
