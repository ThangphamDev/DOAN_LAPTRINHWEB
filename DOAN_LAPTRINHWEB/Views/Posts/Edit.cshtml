
@model DOAN_LAPTRINHWEB.Models.Post

@{
    ViewData["Title"] = "Sửa bài viết";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<div class="container mt-5">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Title" class="form-label">Tiêu đề</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Content" class="form-label" style="display:none">Nội dung</label>
            <textarea asp-for="Content" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ImageUrls" class="form-label">URL hình ảnh</label>
            <input asp-for="ImageUrls" class="form-control" />
            <span asp-validation-for="ImageUrls" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PostTypeId" class="form-label">Loại bài viết</label>
            <select asp-for="PostTypeId" class="form-select" asp-items="@(new SelectList(ViewData["PostTypes"] as List<DOAN_LAPTRINHWEB.Models.PostType>, "Id", "Name"))">
                <option value="">Chọn loại bài viết</option>
            </select>
            <span asp-validation-for="PostTypeId" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a asp-action="MyPosts" class="btn btn-secondary">Quay lại</a>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.tiny.cloud/1/dlw5y4nq5zad9avo50yhqzcfkodnsankzz7bh511nmbds50d/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
<script>
    tinymce.init({
        selector: '#Content', // đảm bảo ID đúng với textarea của bạn
        plugins: 'image code',
        toolbar: 'undo redo | bold italic | alignleft aligncenter alignright | code | image',
        relative_urls: false,                   // Bắt TinyMCE dùng absolute URLs
        remove_script_host: false,              // Đừng bỏ host trong URL
        convert_urls: false,                    // Không tự chuyển đổi đường dẫn

        setup: function (editor) {
            editor.on('BeforeSetContent', function (e) {
                if (e.content) {
                    e.content = e.content.replace(/(\.\.\/|\.{2}\/\/)+uploads\//g, '/uploads/');
                }
            });
            editor.on('GetContent', function (e) {
                if (e.content) {
                    e.content = e.content.replace(/(\.\.\/|\.{2}\/\/)+uploads\//g, '/uploads/');
                }
            });
        }
    });
</script>


}