@model IEnumerable<DOAN_LAPTRINHWEB.Models.Post>

@{
    ViewData["Title"] = "Bài viết";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fb-layout-container">
    <!-- Left sidebar -->
    <div class="fb-sidebar left-sidebar">
        <div class="fb-sidebar-content">
            <div class="fb-profile-section">
                <a asp-action="MyPosts" class="fb-menu-item active">
                    <div class="fb-menu-icon">
                        <i class="fas fa-newspaper"></i>
                    </div>
                    <div class="fb-menu-text">Blog HomeStyle</div>
                </a>
                <div class="fb-menu-subtitle">Khám phá nội dung</div>
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-action="MyPosts" class="fb-menu-item">
                        <div class="fb-menu-icon">
                            <i class="fas fa-user-edit"></i>
                        </div>
                        <div class="fb-menu-text">Bài viết của tôi</div>
                    </a>
                }
                <a href="#" class="fb-menu-item">
                    <div class="fb-menu-icon">
                        <i class="fas fa-fire"></i>
                    </div>
                    <div class="fb-menu-text">Xu hướng</div>
                </a>
                <a href="#" class="fb-menu-item">
                    <div class="fb-menu-icon">
                        <i class="fas fa-bookmark"></i>
                    </div>
                    <div class="fb-menu-text">Đã lưu</div>
                </a>
            </div>
            <div class="fb-categories-section">
                <div class="fb-menu-subtitle">Loại bài viết</div>
                <a href="@Url.Action("Index")"
                   class="fb-menu-item @(ViewBag.CurrentPostTypeId == null ? "active" : "")">
                    <div class="fb-menu-icon">
                        <i class="fas fa-border-all"></i>
                    </div>
                    <div class="fb-menu-text">Tất cả</div>
                </a>
                @foreach (var postType in ViewBag.PostTypes as List<DOAN_LAPTRINHWEB.Models.PostType>)
                {
                    <a href="@Url.Action("Index", new { postTypeId = postType.Id })"
                       class="fb-menu-item @(ViewBag.CurrentPostTypeId == postType.Id ? "active" : "")">
                        <div class="fb-menu-icon">
                            <i class="fas fa-hashtag"></i>
                        </div>
                        <div class="fb-menu-text">@postType.Name</div>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Main feed -->
    <div class="fb-main-feed">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <!-- Create post section -->
        @if (User.Identity.IsAuthenticated)
        {
            <div class="create-post-card">
                <div class="create-post-header">
                    <div class="avatar-circle">
                        @{
                            var currentUser = ViewBag.CurrentUser as DOAN_LAPTRINHWEB.Models.ApplicationUser;
                        }
                        @if (currentUser != null && !string.IsNullOrEmpty(currentUser.AvatarUrl))
                        {
                            <img src="@currentUser.AvatarUrl" alt="Avatar" class="avatar-img" />
                        }
                        else if (currentUser != null && !string.IsNullOrEmpty(currentUser.Avatar))
                        {
                            <img src="@currentUser.Avatar" alt="Avatar" class="avatar-img" />
                        }
                        else
                        {
                            <i class="fas fa-user"></i>
                        }
                    </div>
                    <a asp-action="Create" class="create-post-input">
                        Bạn đang nghĩ gì thế?
                    </a>
                </div>
                <div class="create-post-actions">
                    <a asp-action="Create" class="create-post-action">
                        <i class="fas fa-image text-success"></i>
                        <span>Ảnh/Video</span>
                    </a>
                    <a asp-action="Create" class="create-post-action">
                        <i class="fas fa-edit text-primary"></i>
                        <span>Tạo bài viết</span>
                    </a>
                </div>
            </div>
        }

        <!-- Stories/Filters section -->
        <div class="stories-section">
            <div class="stories-container">
                <div class="story-filter @(ViewBag.CurrentPostTypeId == null ? "active" : "")"
                     onclick="window.location.href='@Url.Action("Index")'">
                    <div class="story-icon">
                        <i class="fas fa-border-all"></i>
                    </div>
                    <div class="story-name">Tất cả</div>
                </div>
                @foreach (var postType in ViewBag.PostTypes as List<DOAN_LAPTRINHWEB.Models.PostType>)
                {
                    <div class="story-filter @(ViewBag.CurrentPostTypeId == postType.Id ? "active" : "")"
                         onclick="window.location.href='@Url.Action("Index", new { postTypeId = postType.Id })'">
                        <div class="story-icon">
                            <i class="fas fa-hashtag"></i>
                        </div>
                        <div class="story-name">@postType.Name</div>
                    </div>
                }
            </div>
        </div>

        <!-- Posts feed -->
        @if (Model.Any())
        {
            @foreach (var post in Model)
            {
                <div class="fb-post-card">
                    <div class="fb-post-header">
                        <div class="fb-post-user">
                            <div class="fb-post-avatar">
                                @if (!string.IsNullOrEmpty(post.User?.AvatarUrl))
                                {
                                    <img src="@post.User.AvatarUrl" alt="Avatar" class="avatar-img" />
                                }
                                else if (!string.IsNullOrEmpty(post.User?.Avatar))
                                {
                                    <img src="@post.User.Avatar" alt="Avatar" class="avatar-img" />
                                }
                                else
                                {
                                    <i class="fas fa-user"></i>
                                }
                            </div>
                            <div class="fb-post-info">
                                <div class="fb-post-author">@(post.User?.FullName ?? "Ẩn danh")</div>
                                <div class="fb-post-meta">
                                    <span>@post.CreatedDate.ToString("dd/MM/yyyy")</span>
                                    <span class="post-category-badge">@post.PostType.Name</span>
                                </div>
                            </div>
                        </div>
                        <div class="fb-post-actions">
                            <button class="fb-post-action">
                                <i class="fas fa-ellipsis-h"></i>
                            </button>
                        </div>
                    </div>

                    <div class="fb-post-content">
                        <h3 class="fb-post-title">
                            <a href="@Url.Action("Details", new { id = post.Id })">@post.Title</a>
                        </h3>
                        <div class="fb-post-text" id="post-content-@post.Id">
                            @{
                                var plainText = System.Text.RegularExpressions.Regex.Replace(post.Content, "<.*?>", "");
                                var shouldTruncate = plainText.Length > 200;
                                var truncatedText = shouldTruncate ? plainText.Substring(0, 200) : plainText;
                            }

                            <span class="content-preview" id="preview-@post.Id">
                                @truncatedText
                                @if (shouldTruncate)
                                {
                                    <span>...</span>
                                    <span class="see-more-btn" onclick="showFullContent(@post.Id)">Xem thêm</span>
                                }
                            </span>

                            @if (shouldTruncate)
                            {
                                <span class="content-full" id="full-@post.Id" style="display: none;">
                                    @Html.Raw(post.Content)
                                    <span class="see-less-btn" onclick="showPreviewContent(@post.Id)">Ẩn bớt</span>
                                </span>
                            }
                        </div>
                    </div>


                    @if (!string.IsNullOrEmpty(post.ImageUrls))
                    {
                        var firstImage = post.ImageUrls.Split(',').FirstOrDefault()?.Trim();
                        if (!string.IsNullOrEmpty(firstImage))
                        {
                            <div class="fb-post-media">
                                @if (!firstImage.StartsWith("http") && !firstImage.StartsWith("/"))
                                {
                                    <img src="/@firstImage" alt="@post.Title">
                                }
                                else
                                {
                                    <img src="@firstImage" alt="@post.Title">
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="fb-post-media">
                            <img src="~/images/blog-placeholder.jpg" alt="@post.Title">
                        </div>
                    }

                    <!-- Thêm phần hiển thị số lượng like và comment -->
                    @{
                        var likeCounts = ViewBag.LikeCounts as Dictionary<int, int>;
                        var commentCounts = ViewBag.CommentCounts as Dictionary<int, int>;
                        var userLikes = ViewBag.UserLikes as Dictionary<int, bool>;

                        var likeCount = likeCounts?.ContainsKey(post.Id) == true ? likeCounts[post.Id] : 0;
                        var commentCount = commentCounts?.ContainsKey(post.Id) == true ? commentCounts[post.Id] : 0;
                        var isLiked = userLikes?.ContainsKey(post.Id) == true ? userLikes[post.Id] : false;
                    }

                    <!-- Hiển thị thống kê like và comment -->
                    @if (likeCount > 0 || commentCount > 0)
                    {
                        <div class="fb-post-stats">
                            <div class="fb-post-stats-left">
                                @if (likeCount > 0)
                                {
                                    <span class="fb-post-stat-item">
                                        <i class="fas fa-thumbs-up text-primary"></i>
                                        <span>@likeCount</span>
                                    </span>
                                }
                            </div>
                            <div class="fb-post-stats-right">
                                @if (commentCount > 0)
                                {
                                    <span class="fb-post-stat-item">
                                        <span>@commentCount bình luận</span>
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    <div class="fb-post-footer">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <button type="button" class="fb-post-reaction @(isLiked ? "liked" : "")" onclick="likePostFromIndex(@post.Id, this)">
                                <i class="@(isLiked ? "fas" : "far") fa-thumbs-up"></i>
                                <span>@(isLiked ? "Đã thích" : "Thích")</span>
                            </button>
                        }
                        else
                        {
                            <a href="@Url.Action("Details", new { id = post.Id })" class="fb-post-reaction">
                                <i class="far fa-thumbs-up"></i>
                                <span>Thích</span>
                            </a>
                        }

                        <a href="@Url.Action("Details", new { id = post.Id })" class="fb-post-reaction">
                            <i class="far fa-comment"></i>
                            <span>Bình luận</span>
                        </a>
                        <a href="@Url.Action("Details", new { id = post.Id })" class="fb-post-reaction">
                            <i class="fas fa-share"></i>
                            <span>Chia sẻ</span>
                        </a>
                    </div>
                </div>
            }


            <!-- Pagination -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="fb-pagination">
                    <div class="fb-pagination-inner">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <a class="fb-pagination-item" href="@Url.Action("Index", new { postTypeId = ViewBag.CurrentPostTypeId, page = ViewBag.CurrentPage - 1 })">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        }

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <a class="fb-pagination-item @(i == ViewBag.CurrentPage ? "active" : "")"
                               href="@Url.Action("Index", new { postTypeId = ViewBag.CurrentPostTypeId, page = i })">
                                @i
                            </a>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <a class="fb-pagination-item" href="@Url.Action("Index", new { postTypeId = ViewBag.CurrentPostTypeId, page = ViewBag.CurrentPage + 1 })">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="fb-empty-state">
                <div class="fb-empty-icon">
                    <i class="fas fa-newspaper"></i>
                </div>
                <h4>Chưa có bài viết nào</h4>
                <p>
                    @if (ViewBag.CurrentPostTypeId != null)
                    {
                        <span>Không có bài viết nào thuộc loại này.</span>
                    }
                    else
                    {
                        <span>Hãy là người đầu tiên chia sẻ bài viết!</span>
                    }
                </p>
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i> Tạo bài viết đầu tiên
                    </a>
                }
            </div>
        }
    </div>

    <!-- Right sidebar -->
    <div class="fb-sidebar right-sidebar">
        <div class="fb-sidebar-content">
            <div class="fb-sponsored">
                <h5 class="fb-sidebar-title">Bài nổi bật</h5>
                <div class="fb-recommended-posts">
                    <div class="fb-recommended-post">
                        <div class="fb-recommended-img">
                            <img src="~/images/blog-placeholder.jpg" alt="Gợi ý bài viết">
                        </div>
                        <div class="fb-recommended-info">
                            <div class="fb-recommended-title">Ý tưởng trang trí phòng khách</div>
                            <div class="fb-recommended-meta">2 giờ trước</div>
                        </div>
                    </div>
                    <div class="fb-recommended-post">
                        <div class="fb-recommended-img">
                            <img src="~/images/blog-placeholder.jpg" alt="Gợi ý bài viết">
                        </div>
                        <div class="fb-recommended-info">
                            <div class="fb-recommended-title">Những xu hướng mới nhất 2025</div>
                            <div class="fb-recommended-meta">1 ngày trước</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="fb-contacts">
                <h5 class="fb-sidebar-title">Tác giả nổi bật</h5>
                <div class="fb-contact-list">
                    <div class="fb-contact-item">
                        <div class="fb-contact-avatar">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="fb-contact-name">Nguyễn Văn A</div>
                    </div>
                    <div class="fb-contact-item">
                        <div class="fb-contact-avatar">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="fb-contact-name">Trần Thị B</div>
                    </div>
                    <div class="fb-contact-item">
                        <div class="fb-contact-avatar">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="fb-contact-name">Lê Văn C</div>
                    </div>
                </div>
            </div>

            <div class="fb-footer">
                <div class="fb-footer-links">
                    <a href="#">Điều khoản</a>
                    <a href="#">Bảo mật</a>
                    <a href="#">Quảng cáo</a>
                    <a href="#">Liên hệ</a>
                </div>
                <div class="fb-copyright">
                    HomeStyle © 2025
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Facebook-style layout */
    /* Facebook-style layout */
    :root {
        --fb-bg: #f0f2f5;
        --fb-card-bg: #ffffff;
        --fb-primary-text: #1c1e21;
        --fb-secondary-text: #65676b;
        --fb-hover-bg: #f2f2f2;
        --fb-active-bg: #e7f3ff;
        --fb-active-color: #1877f2;
        --fb-border: #e4e6eb;
        --fb-primary-button: #1877f2;
        --fb-icon-bg: #e4e6eb;
        --fb-divider: #ced0d4;
    }

    body {
        background-color: var(--fb-bg) !important;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    /* Thêm vào phần CSS trong Index.cshtml */
    .fb-post-stats {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 16px;
        border-bottom: 1px solid var(--fb-border);
        font-size: 13px;
        color: var(--fb-secondary-text);
    }

    .fb-post-stats-left,
    .fb-post-stats-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .fb-post-stat-item {
        display: flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
    }

        .fb-post-stat-item i {
            width: 16px;
            height: 16px;
            background: linear-gradient(45deg, #1877f2, #42a5f5);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 10px;
        }

        .fb-post-stat-item:hover {
            text-decoration: underline;
        }

    .fb-post-reaction.liked {
        color: var(--fb-active-color);
        background-color: rgba(24, 119, 242, 0.1);
    }

        .fb-post-reaction.liked i {
            animation: likeAnimation 0.3s ease;
        }

        .fb-post-reaction.liked:hover {
            background-color: rgba(24, 119, 242, 0.15);
            color: var(--fb-active-color);
        }

    .fb-layout-container {
        display: flex;
        max-width: 1920px;
        margin: 0 auto;
        padding-top: 20px;
        position: relative;
    }

    /* Sidebar styles */
    .fb-sidebar {
        width: 360px;
        height: calc(100vh - 100px);
        position: sticky;
        top: 80px;
        overflow-y: auto;
    }

    .left-sidebar {
        padding-right: 15px;
    }

    .right-sidebar {
        padding-left: 15px;
    }

    .fb-sidebar-content {
        padding: 0 8px;
    }

    /* Main feed */
    .fb-main-feed {
        flex: 1;
        max-width: 680px;
        margin: 0 auto;
    }

    /* Menu items */
    .fb-menu-item {
        display: flex;
        align-items: center;
        padding: 8px 12px;
        border-radius: 10px;
        text-decoration: none;
        color: var(--fb-primary-text);
        margin-bottom: 5px;
        transition: all 0.2s ease;
    }

        .fb-menu-item:hover {
            background-color: var(--fb-hover-bg);
            color: var(--fb-primary-text);
        }

        .fb-menu-item.active {
            background-color: var(--fb-active-bg);
            color: var(--fb-active-color);
            font-weight: 500;
        }

    .fb-menu-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: var(--fb-icon-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
    }

    .fb-menu-item.active .fb-menu-icon {
        background-color: #d4e5f9;
    }

    .fb-menu-text {
        font-size: 15px;
        font-weight: 500;
    }

    .fb-menu-subtitle {
        color: var(--fb-secondary-text);
        font-weight: 600;
        padding: 10px 12px 8px;
        font-size: 17px;
    }

    /* Sections */
    .fb-profile-section,
    .fb-categories-section {
        margin-bottom: 20px;
    }

    /* Avatar styles */
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #e4e6eb;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 10px;
        overflow: hidden;
    }

    .avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
    }

    .fb-post-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: #e4e6eb;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 10px;
        overflow: hidden;
    }

    .fb-contact-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: var(--fb-icon-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 10px;
        overflow: hidden;
    }

    /* Create post card */
    .create-post-card {
        background-color: var(--fb-card-bg);
        border-radius: 8px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
        padding: 12px 16px 10px;
        margin-bottom: 16px;
    }

    .create-post-header {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
    }

    .create-post-input {
        flex: 1;
        background-color: #f0f2f5;
        border-radius: 20px;
        padding: 10px 15px;
        font-size: 15px;
        color: var(--fb-secondary-text);
        cursor: pointer;
        text-decoration: none;
    }

        .create-post-input:hover {
            background-color: var(--fb-hover-bg);
            color: var(--fb-secondary-text);
        }

    .create-post-actions {
        display: flex;
        border-top: 1px solid var(--fb-border);
        margin-top: 5px;
        padding-top: 10px;
    }

    .create-post-action {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        border-radius: 8px;
        color: var(--fb-secondary-text);
        text-decoration: none;
        transition: background-color 0.2s;
    }

        .create-post-action:hover {
            background-color: var(--fb-hover-bg);
            color: var(--fb-secondary-text);
        }

        .create-post-action i {
            margin-right: 8px;
            font-size: 18px;
        }

    /* Stories/Filters section */
    .stories-section {
        margin-bottom: 16px;
        background-color: var(--fb-card-bg);
        border-radius: 8px;
        padding: 15px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }

    .stories-container {
        display: flex;
        overflow-x: auto;
        padding: 5px 0;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

        .stories-container::-webkit-scrollbar {
            display: none;
        }

    .story-filter {
        min-width: 100px;
        padding: 10px;
        margin-right: 10px;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        cursor: pointer;
        transition: all 0.2s;
        border: 1px solid var(--fb-border);
    }

        .story-filter:hover {
            background-color: var(--fb-hover-bg);
        }

        .story-filter.active {
            background-color: var(--fb-active-bg);
            border-color: var(--fb-active-color);
        }

    .story-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: var(--fb-icon-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 5px;
    }

    .story-filter.active .story-icon {
        background-color: #d4e5f9;
    }

    .story-name {
        font-size: 14px;
        color: var(--fb-primary-text);
        font-weight: 500;
        text-align: center;
    }

    /* Post card - Facebook style */
    .fb-post-card {
        background-color: var(--fb-card-bg);
        border-radius: 8px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
        margin-bottom: 16px;
        overflow: hidden;
    }

    .fb-post-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
    }

    .fb-post-user {
        display: flex;
        align-items: center;
    }

    .fb-post-info {
        display: flex;
        flex-direction: column;
    }

    .fb-post-author {
        font-weight: 600;
