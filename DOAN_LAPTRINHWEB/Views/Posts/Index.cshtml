    <script>
        function showFullContent(postId) {
        const preview = document.getElementById(`preview-${postId}`);
        const full = document.getElementById(`full-${postId}`);

        if (preview && full) {
            preview.style.display = 'none';
            full.style.display = 'block';

            setTimeout(() => {
                full.style.transition = 'all 0.3s ease';
                full.style.opacity = '1';
                full.style.transform = 'translateY(0)';
            }, 10);
        }
    }

    function showPreviewContent(postId) {
        const preview = document.getElementById(`preview-${postId}`);
        const full = document.getElementById(`full-${postId}`);

        if (preview && full) {
            full.style.transition = 'all 0.3s ease';
            full.style.opacity = '0';
            full.style.transform = 'translateY(-10px)';

            setTimeout(() => {
                full.style.display = 'none';
                preview.style.display = 'block';

                setTimeout(() => {
                    preview.style.opacity = '1';
                    preview.style.transform = 'translateY(0)';
                }, 10);
            }, 300);
        }
    }


    // Thêm đoạn mã để xử lý khoảng trắng khi trang tải xong
    document.addEventListener('DOMContentLoaded', function() {
        // Xử lý tất cả các đoạn nội dung để loại bỏ khoảng trắng không cần thiết
        document.querySelectorAll('.fb-post-text').forEach(function(element) {
            // Áp dụng kiểu hiển thị nhỏ gọn
            element.style.margin = '0 0 12px 0';
            element.style.whiteSpace = 'normal';
        });

        // Đảm bảo các phần tử con của post content có khoảng cách tối thiểu
        document.querySelectorAll('.fb-post-content > *').forEach(function(element) {
            element.style.marginTop = '0';
            element.style.marginBottom = '4px';
        });

        // Đảm bảo content-preview được hiển thị dạng inline
        document.querySelectorAll('.content-preview').forEach(function(element) {
            element.style.display = 'inline';
        });
    });

         function likePostFromIndex(postId, button) {
        // Disable button để tránh spam click
        button.disabled = true;

        // Hiệu ứng ngay lập tức (optimistic update)
        const icon = button.querySelector('i');
        const text = button.querySelector('span');
        const postCard = button.closest('.fb-post-card');
        let statsSection = postCard.querySelector('.fb-post-stats');

        // Lấy trạng thái hiện tại
        const isCurrentlyLiked = button.classList.contains('liked');
        const newLikedState = !isCurrentlyLiked;

        // Cập nhật UI ngay lập tức
        if (newLikedState) {
            // Thích
            button.classList.add('liked');
            icon.classList.remove('far');
            icon.classList.add('fas');
            text.textContent = 'Đã thích';
        } else {
            // Bỏ thích
            button.classList.remove('liked');
            icon.classList.remove('fas');
            icon.classList.add('far');
            text.textContent = 'Thích';
        }

        // Gửi request đến server
        $.ajax({
            url: '@Url.Action("LikePost", "Posts")',
            type: 'POST',
            data: { id: postId },
            success: function(response) {
                if (response.success) {
                    // Cập nhật số lượng like chính xác từ server
                    updateLikeCount(postCard, response.likeCount);
                } else {
                    // Nếu server trả về lỗi, revert lại UI
                    revertLikeUI(button, !newLikedState);
                    alert(response.message || 'Có lỗi xảy ra');
                }
            },
            error: function() {
                // Nếu có lỗi, revert lại UI
                revertLikeUI(button, !newLikedState);
                alert('Đã xảy ra lỗi khi thực hiện thao tác. Vui lòng thử lại.');
            },
            complete: function() {
                // Enable lại button
                button.disabled = false;
            }
        });
    }

    function revertLikeUI(button, shouldBeLiked) {
        const icon = button.querySelector('i');
        const text = button.querySelector('span');

        if (shouldBeLiked) {
            button.classList.add('liked');
            icon.classList.remove('far');
            icon.classList.add('fas');
            text.textContent = 'Đã thích';
        } else {
            button.classList.remove('liked');
            icon.classList.remove('fas');
            icon.classList.add('far');
            text.textContent = 'Thích';
        }
    }

    function updateLikeCount(postCard, likeCount) {
        let statsSection = postCard.querySelector('.fb-post-stats');

        if (likeCount > 0) {
            // Nếu chưa có stats section, tạo mới
            if (!statsSection) {
                const mediaSection = postCard.querySelector('.fb-post-media');
                const footerSection = postCard.querySelector('.fb-post-footer');

                statsSection = document.createElement('div');
                statsSection.className = 'fb-post-stats';
                statsSection.innerHTML = `
                    <div class="fb-post-stats-left"></div>
                    <div class="fb-post-stats-right"></div>
                `;

                postCard.insertBefore(statsSection, footerSection);
            }

            const statsLeft = statsSection.querySelector('.fb-post-stats-left');
            let likeStatItem = statsLeft.querySelector('.fb-post-stat-item');

            if (likeStatItem) {
                likeStatItem.querySelector('span').textContent = likeCount;
            } else {
                statsLeft.innerHTML = `
                    <span class="fb-post-stat-item">
                        <i class="fas fa-thumbs-up"></i>
                        <span>${likeCount}</span>
                    </span>
                `;
            }
        } else {
            // Nếu không còn like nào, xóa stats section nếu cũng không có comment
            if (statsSection) {
                const statsLeft = statsSection.querySelector('.fb-post-stats-left');
                const statsRight = statsSection.querySelector('.fb-post-stats-right');

                statsLeft.innerHTML = '';

                // Nếu cả left và right đều trống, xóa toàn bộ stats section
                if (!statsLeft.innerHTML.trim() && !statsRight.innerHTML.trim()) {
                    statsSection.remove();
                }
            }
        }
    }

    // Thêm CSS cho disabled state
    document.addEventListener('DOMContentLoaded', function() {
        const style = document.createElement('style');
        style.textContent = `
            .fb-post-reaction:disabled {
                opacity: 0.7;
                cursor: not-allowed;
            }
        `;
        document.head.appendChild(style);
    });
</script>

