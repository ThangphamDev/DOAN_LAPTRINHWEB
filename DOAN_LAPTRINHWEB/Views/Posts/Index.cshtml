@model IEnumerable<DOAN_LAPTRINHWEB.Models.Post>

@{
    ViewData["Title"] = "Bài viết";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


    <style>
        /* Tránh header che nội dung */
        .posts-container {
            padding-top: 100px; /* Điều chỉnh theo chiều cao header */
        }

        /* Hero section cho trang blog */
        .blog-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 80px 0 60px;
            margin-top: -100px;
            padding-top: 180px;
        }

        .blog-hero h1 {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .blog-hero p {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        /* Filter section */
        .filter-section {
            background: #f8f9fa;
            padding: 2rem 0;
            border-bottom: 1px solid #e9ecef;
        }

        .filter-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            justify-content: center;
        }

        .filter-btn {
            padding: 0.5rem 1.5rem;
            border: 2px solid #dee2e6;
            background: white;
            color: #6c757d;
            text-decoration: none;
            border-radius: 25px;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .filter-btn:hover {
            border-color: #495057;
            color: #495057;
            transform: translateY(-2px);
        }

        .filter-btn.active {
            background: #495057;
            border-color: #495057;
            color: white;
        }

        /* Blog cards */
        .blog-section {
            padding: 4rem 0;
        }

        .blog-card {
            border: none;
            border-radius: 15px;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            height: 100%;
        }

        .blog-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }

        .blog-card-img {
            height: 250px;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .blog-card:hover .blog-card-img {
            transform: scale(1.05);
        }

        .blog-card-body {
            padding: 1.5rem;
        }

        .blog-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .blog-category {
            background: linear-gradient(45deg, #667eea, #764ba2);
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .blog-date {
            color: #6c757d;
            font-size: 0.9rem;
        }

        .blog-title {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 1rem;
            line-height: 1.4;
        }

        .blog-title a {
            color: #2c3e50;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .blog-title a:hover {
            color: #667eea;
        }

        .blog-excerpt {
            color: #6c757d;
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }

        .blog-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 1rem;
            border-top: 1px solid #e9ecef;
        }

        .blog-author {
            display: flex;
            align-items: center;
            color: #6c757d;
            font-size: 0.9rem;
        }

        .blog-author i {
            margin-right: 0.5rem;
        }

        .read-more-btn {
            background: linear-gradient(45deg, #667eea, #764ba2);
            border: none;
            color: white;
            padding: 0.5rem 1.5rem;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .read-more-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            color: white;
        }

        /* Action buttons */
        .action-buttons {
            margin-bottom: 2rem;
        }

        .btn-create, .btn-my-posts {
            padding: 0.75rem 2rem;
            border-radius: 25px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-create {
            background: linear-gradient(45deg, #667eea, #764ba2);
            border: none;
            color: white;
        }

        .btn-create:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            color: white;
        }

        .btn-my-posts {
            border: 2px solid #667eea;
            color: #667eea;
            background: transparent;
        }

        .btn-my-posts:hover {
            background: #667eea;
            color: white;
            transform: translateY(-2px);
        }

        /* Pagination */
        .custom-pagination {
            margin-top: 3rem;
        }

        .custom-pagination .page-link {
            border: none;
            color: #667eea;
            padding: 0.75rem 1rem;
            margin: 0 0.25rem;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .custom-pagination .page-item.active .page-link {
            background: linear-gradient(45deg, #667eea, #764ba2);
            border-color: transparent;
        }

        .custom-pagination .page-link:hover {
            background: #f8f9fa;
            transform: translateY(-2px);
        }

        /* Empty state */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
        }

        .empty-state i {
            font-size: 4rem;
            color: #dee2e6;
            margin-bottom: 1.5rem;
        }

        .empty-state h4 {
            color: #6c757d;
            margin-bottom: 1rem;
        }

        .empty-state p {
            color: #adb5bd;
            margin-bottom: 2rem;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .posts-container {
                padding-top: 80px;
            }

            .blog-hero {
                padding-top: 160px;
                padding-bottom: 40px;
            }

            .blog-hero h1 {
                font-size: 2rem;
            }

            .filter-buttons {
                justify-content: flex-start;
                overflow-x: auto;
                padding-bottom: 0.5rem;
            }

            .filter-btn {
                white-space: nowrap;
            }

            .action-buttons {
                text-align: center;
            }

            .action-buttons .btn {
                display: block;
                width: 100%;
                margin-bottom: 0.5rem;
            }
        }
        /* Floating Action Button */
    .floating-action-btn {
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 1000;
    }

    .floating-action-btn .btn {
        width: 60px;
        height: 60px;
        box-shadow: 0 4px 20px rgba(102, 126, 234, 0.4);
        border: none;
    }

    .floating-action-btn .btn:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 25px rgba(102, 126, 234, 0.6);
    }

    /* Additional animations */
    .blog-card {
        animation: fadeInUp 0.6s ease-out;
    }

    .blog-card:nth-child(2) {
        animation-delay: 0.1s;
    }

    .blog-card:nth-child(3) {
        animation-delay: 0.2s;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Loading state */
    .loading {
        opacity: 0.7;
        pointer-events: none;
    }

    /* Improved responsive design */
    @@media (max-width: 576px) {
        .blog-hero h1 {
            font-size: 1.8rem;
        }

        .blog-hero p {
            font-size: 1rem;
        }

        .blog-card-body {
            padding: 1rem;
        }

        .blog-title {
            font-size: 1.1rem;
        }

        .filter-buttons {
            padding: 0 1rem;
        }

        .action-buttons .btn {
            font-size: 0.9rem;
            padding: 0.6rem 1.5rem;
        }
    }

    /* Dark mode support (optional) */
    @@media (prefers-color-scheme: dark) {
        .filter-section {
            background: #2c3e50;
        }

        .filter-btn {
            background: #34495e;
            color: #ecf0f1;
            border-color: #4a5f7a;
        }

        .filter-btn:hover {
            border-color: #667eea;
            color: #667eea;
        }

        .blog-card {
            background: #34495e;
            color: #ecf0f1;
        }

        .blog-title a {
            color: #ecf0f1;
        }

        .blog-excerpt {
            color: #bdc3c7;
        }

        .blog-author {
            color: #bdc3c7;
        }

        .blog-date {
            color: #bdc3c7;
        }
    }
    </style>

<div class="posts-container">
    <!-- Hero Section -->
    <section class="blog-hero">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto text-center">
                    <h1>
                        <i class="fas fa-newspaper me-3"></i>
                        Blog & Cảm Hứng
                    </h1>
                    <p class="lead">Khám phá những ý tưởng trang trí mới nhất và chia sẻ cảm hứng thiết kế không gian sống</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Filter Section -->
    <section class="filter-section">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h6 class="text-center mb-3 text-muted">Lọc theo chủ đề:</h6>
                    <div class="filter-buttons">
                        <a href="@Url.Action("Index")" 
                           class="filter-btn @(ViewBag.CurrentPostTypeId == null ? "active" : "")">
                            <i class="fas fa-th-large me-1"></i> Tất cả
                        </a>
                        @foreach (var postType in ViewBag.PostTypes as List<DOAN_LAPTRINHWEB.Models.PostType>)
                        {
                            <a href="@Url.Action("Index", new { postTypeId = postType.Id })" 
                               class="filter-btn @(ViewBag.CurrentPostTypeId == postType.Id ? "active" : "")">
                                @postType.Name
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <section class="blog-section">
        <div class="container">
            <!-- Action Buttons -->
            @if (User.Identity.IsAuthenticated)
            {
                <div class="action-buttons text-center">
                    <a asp-action="Create" class="btn btn-create me-3">
                        <i class="fas fa-plus me-2"></i> Tạo bài viết mới
                    </a>
                    <a asp-action="MyPosts" class="btn btn-my-posts">
                        <i class="fas fa-user-edit me-2"></i> Bài viết của tôi
                    </a>
                </div>
            }

            <!-- Blog Posts -->
            @if (Model.Any())
            {
                <div class="row g-4">
                    @foreach (var post in Model)
                    {
                        <div class="col-lg-4 col-md-6">
                            <article class="card blog-card">
                                @if (!string.IsNullOrEmpty(post.ImageUrls))
                                {
                                    var firstImage = post.ImageUrls.Split(',').FirstOrDefault()?.Trim();
                                    if (!string.IsNullOrEmpty(firstImage))
                                    {
                                        <img src="@firstImage" class="blog-card-img" alt="@post.Title">
                                    }
                                }
                                else
                                {
                                    <div class="blog-card-img d-flex align-items-center justify-content-center bg-light">
                                        <i class="fas fa-image fa-3x text-muted"></i>
                                    </div>
                                }
                                
                                <div class="blog-card-body">
                                    <div class="blog-meta">
                                        <span class="blog-category">@post.PostType.Name</span>
                                        <span class="blog-date">
                                            <i class="far fa-calendar-alt me-1"></i>
                                            @post.CreatedDate.ToString("dd/MM/yyyy")
                                        </span>
                                    </div>
                                    
                                    <h3 class="blog-title">
                                        <a href="@Url.Action("Details", new { id = post.Id })">
                                            @post.Title
                                        </a>
                                    </h3>
                                    
                                    <div class="blog-excerpt">
                                        @{
                                            var plainText = System.Text.RegularExpressions.Regex.Replace(post.Content, "<.*?>", "");
                                            var truncatedText = plainText.Length > 120 ? plainText.Substring(0, 120) + "..." : plainText;
                                        }
                                        @truncatedText
                                    </div>
                                    
                                    <div class="blog-footer">
                                        <div class="blog-author">
                                            <i class="fas fa-user-circle"></i>
                                            @(post.User?.FullName ?? "Ẩn danh")
                                        </div>
                                        <a href="@Url.Action("Details", new { id = post.Id })" 
                                           class="read-more-btn">
                                            Đọc thêm
                                        </a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (ViewBag.TotalPages > 1)
                {
                    <nav aria-label="Blog pagination" class="custom-pagination">
                        <ul class="pagination justify-content-center">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { postTypeId = ViewBag.CurrentPostTypeId, page = ViewBag.CurrentPage - 1 })">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                </li>
                            }

                            @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { postTypeId = ViewBag.CurrentPostTypeId, page = i })">
                                        @i
                                    </a>
                                </li>
                            }

                                                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { postTypeId = ViewBag.CurrentPostTypeId, page = ViewBag.CurrentPage + 1 })">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <!-- Empty State -->
                <div class="empty-state">
                    <i class="fas fa-newspaper"></i>
                    <h4>Chưa có bài viết nào</h4>
                    <p>
                        @if (ViewBag.CurrentPostTypeId != null)
                        {
                            <span>Không có bài viết nào thuộc chủ đề này.</span>
                        }
                        else
                        {
                            <span>Hãy là người đầu tiên chia sẻ cảm hứng trang trí!</span>
                        }
                    </p>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-action="Create" class="btn btn-create">
                            <i class="fas fa-plus me-2"></i> Tạo bài viết đầu tiên
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-create">
                            <i class="fas fa-sign-in-alt me-2"></i> Đăng nhập để viết bài
                        </a>
                    }
                </div>
            }
        </div>
    </section>
</div>

<!-- Floating Action Button for Mobile -->
@if (User.Identity.IsAuthenticated)
{
    <div class="floating-action-btn d-md-none">
        <a asp-action="Create" class="btn btn-create rounded-circle" title="Tạo bài viết">
            <i class="fas fa-plus"></i>
        </a>
    </div>
}

@section Scripts {
    <script>
        // Smooth scroll for filter buttons on mobile
        document.addEventListener('DOMContentLoaded', function() {
            const filterButtons = document.querySelector('.filter-buttons');
            if (filterButtons) {
                const activeBtn = filterButtons.querySelector('.filter-btn.active');
                if (activeBtn) {
                    activeBtn.scrollIntoView({ behavior: 'smooth', inline: 'center' });
                }
            }
        });

        // Add loading animation for pagination
        document.querySelectorAll('.pagination .page-link').forEach(link => {
            link.addEventListener('click', function() {
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            });
        });
    </script>
}


                            