@using System.Security.Claims
@model DOAN_LAPTRINHWEB.Models.Post
@{
    ViewData["Title"] = "Chi tiết bài viết";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow rounded">
        <div class="card-body">
            <div class="d-flex align-items-center mb-3">
                <div class="fb-post-avatar me-3">
                    @if (!string.IsNullOrEmpty(Model.User?.AvatarUrl))
                    {
                        <img src="@Model.User.AvatarUrl" alt="Avatar" class="avatar-img" />
                    }
                    else if (!string.IsNullOrEmpty(Model.User?.Avatar))
                    {
                        <img src="@Model.User.Avatar" alt="Avatar" class="avatar-img" />
                    }
                    else
                    {
                        <i class="fas fa-user"></i>
                    }
                </div>
                <div class="fb-post-info">
                    <div class="fb-post-author">@(Model.User?.FullName ?? "Ẩn danh")</div>
                    <div class="fb-post-meta">
                        <span>@Model.CreatedDate.ToString("dd/MM/yyyy")</span>
                        <span class="post-category-badge">@Model.PostType.Name</span>
                    </div>
                </div>
            </div>

            <h3 class="card-title mb-3">@Model.Title</h3>

            <div class="mb-4">
                @Html.Raw(Model.Content)
            </div>

            @* Hiển thị ảnh *@
            @if (!string.IsNullOrEmpty(Model.ImageUrls))
            {
                <div class="text-center mt-3 mb-4">
                    <img src="@Url.Content(Model.ImageUrls)" class="img-fluid rounded" alt="Ảnh bài viết" />
                </div>
            }

            <hr class="my-4" />

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <button id="likeButton" class="btn @(ViewBag.UserLiked ? "btn-primary" : "btn-outline-primary")" onclick="likePost(@Model.Id)">
                                <i class="@(ViewBag.UserLiked ? "fas" : "far") fa-thumbs-up"></i>
                                <span id="likeText">@(ViewBag.UserLiked ? "Đã thích" : "Thích")</span>
                                <span id="likeCount" class="ms-1">(@ViewBag.LikesCount)</span>
                            </button>
                        }
                        else
                        {
                            <a href="@Url.Action("Login", "Account", new { area = "Identity", returnUrl = Url.Action("Details", "Posts", new { id = Model.Id }) })" class="btn btn-outline-primary">
                                <i class="far fa-thumbs-up"></i>
                                <span>Thích</span>
                                <span id="likeCount" class="ms-1">(@ViewBag.LikesCount)</span>
                            </a>
                        }
                    </div>
                    <div>
                        <button class="btn btn-outline-secondary" onclick="scrollToComments()">
                            <i class="far fa-comment"></i>
                            <span>Bình luận</span>
                            <span id="commentCount" class="ms-1">(@ViewBag.CommentsCount)</span>
                        </button>
                    </div>
                </div>

                <a asp-action="Index" class="btn btn-light">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>
            </div>

            <hr class="my-4" />

            <!-- Phần bình luận -->
            <div id="commentsSection" class="comments-section">
                <h5 class="mb-4">Bình luận (<span id="commentCountText">@ViewBag.CommentsCount</span>)</h5>

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="d-flex">
                                <div class="avatar-circle me-3">
                                    @{
                                        var currentUser = ViewBag.CurrentUser as DOAN_LAPTRINHWEB.Models.ApplicationUser;
                                    }
                                    @if (currentUser != null && !string.IsNullOrEmpty(currentUser.AvatarUrl))
                                    {
                                        <img src="@currentUser.AvatarUrl" alt="Avatar" class="avatar-img" />
                                    }
                                    else if (currentUser != null && !string.IsNullOrEmpty(currentUser.Avatar))
                                    {
                                        <img src="@currentUser.Avatar" alt="Avatar" class="avatar-img" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-user"></i>
                                    }
                                </div>
                                <div class="flex-grow-1">
                                    <textarea id="commentContent" class="form-control" rows="3" placeholder="Viết bình luận của bạn..."></textarea>
                                    <div class="text-end mt-2">
                                        <button id="addCommentBtn" class="btn btn-primary" onclick="addComment(@Model.Id)">
                                            <i class="fas fa-paper-plane me-1"></i> Gửi bình luận
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-4">
                        <i class="fas fa-info-circle me-2"></i>
                        Vui lòng <a href="@Url.Action("Login", "Account", new { area = "Identity", returnUrl = Url.Action("Details", "Posts", new { id = Model.Id }) })">đăng nhập</a> để bình luận.
                    </div>
                }

                <!-- Danh sách bình luận -->
                <div id="commentsList" class="comments-list">
                    <!-- Comments will be loaded here -->
                    <div class="text-center my-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Đang tải...</span>
                        </div>
                        <p class="mt-2">Đang tải bình luận...</p>
                    </div>
                </div>

                <div id="loadMoreContainer" class="text-center mt-4" style="display: none;">
                    <button id="loadMoreBtn" class="btn btn-outline-primary" onclick="loadMoreComments()">
                        <i class="fas fa-sync-alt me-1"></i> Xem thêm bình luận
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>


    <style>
        .fb-post-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background-color: #e4e6eb;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .avatar-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .fb-post-info {
            display: flex;
            flex-direction: column;
        }

        .fb-post-author {
            font-weight: 600;
            font-size: 16px;
        }

        .fb-post-meta {
            display: flex;
            gap: 8px;
            font-size: 13px;
            color: #65676b;
        }

        .post-category-badge {
            background-color: #e4e6eb;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 500;
        }

        /* Comment styles */
        .avatar-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #e4e6eb;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .comment-item {
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #eee;
        }

            .comment-item:last-child {
                border-bottom: none;
            }

        .comment-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 0.5rem;
        }

        .comment-user {
            display: flex;
            align-items: center;
        }

        .avatar-sm {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #e4e6eb;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            margin-right: 10px;
        }

        .comment-username {
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 0;
        }

        .comment-date {
            font-size: 12px;
            color: #65676b;
        }

        .comment-content {
            margin-left: 42px;
            margin-top: 4px;
            font-size: 14px;
        }

        .comment-actions {
            margin-left: 42px;
            margin-top: 8px;
            display: flex;
            gap: 16px;
        }

        .comment-action {
            background: none;
            border: none;
            color: #65676b;
            font-size: 13px;
            font-weight: 600;
            padding: 0;
            cursor: pointer;
        }

            .comment-action:hover {
                text-decoration: underline;
                color: #1877f2;
            }

        .reply-form {
            margin-left: 42px;
            margin-top: 12px;
            display: none;
        }

        .nested-comments {
            margin-left: 42px;
            margin-top: 16px;
            border-left: 2px solid #eee;
            padding-left: 16px;
        }

        .nested-comment-item {
            margin-bottom: 16px;
        }

            .nested-comment-item:last-child {
                margin-bottom: 0;
            }

        .lds-ring {
            display: inline-block;
            position: relative;
            width: 80px;
            height: 80px;
        }

            .lds-ring div {
                box-sizing: border-box;
                display: block;
                position: absolute;
                width: 64px;
                height: 64px;
                margin: 8px;
                border: 8px solid #1877f2;
                border-radius: 50%;
                animation: lds-ring 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
                border-color: #1877f2 transparent transparent transparent;
            }

                .lds-ring div:nth-child(1) {
                    animation-delay: -0.45s;
                }

                .lds-ring div:nth-child(2) {
                    animation-delay: -0.3s;
                }

                .lds-ring div:nth-child(3) {
                    animation-delay: -0.15s;
                }

        @@keyframes lds-ring {
            0%

        {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }

        }
    </style>

@section Scripts {
    <script>
        let currentPage = 1;
        let totalPages = 1;

        $(document).ready(function() {
            // Tải bình luận khi trang được load
            loadComments(@Model.Id, 1);

            // Xử lý khi nhấn Enter trong textarea
            $("#commentContent").keydown(function(event) {
                if (event.keyCode === 13 && !event.shiftKey) {
                    event.preventDefault();
                    addComment(@Model.Id);
                }
            });
        });

        // Cuộn đến phần bình luận
        function scrollToComments() {
            $('html, body').animate({
                scrollTop: $("#commentsSection").offset().top - 100
            }, 500);
        }

        // Hàm like bài viết
        function likePost(postId) {
            $.ajax({
                url: '@Url.Action("LikePost", "Posts")',
                type: 'POST',
                data: { id: postId },
                success: function(response) {
                    if (response.success) {
                        const likeButton = $('#likeButton');
                        const likeText = $('#likeText');
                        const likeCount = $('#likeCount');

                        if (response.liked) {
                            // Đã thích
                            likeButton.removeClass('btn-outline-primary').addClass('btn-primary');
                            likeButton.find('i').removeClass('far').addClass('fas');
                            likeText.text('Đã thích');
                        } else {
                            // Bỏ thích
                            likeButton.removeClass('btn-primary').addClass('btn-outline-primary');
                            likeButton.find('i').removeClass('fas').addClass('far');
                            likeText.text('Thích');
                        }

                        likeCount.text('(' + response.likeCount + ')');
                    }
                },
                error: function() {
                    alert('Đã xảy ra lỗi khi thực hiện thao tác. Vui lòng thử lại.');
                }
            });
        }

        // Hàm thêm bình luận
        function addComment(postId, parentId = null) {
            const commentInput = parentId ? $(`#replyContent-${parentId}`) : $('#commentContent');
            const content = commentInput.val().trim();

            if (!content) {
                alert('Vui lòng nhập nội dung bình luận!');
                return;
            }

            // Vô hiệu hóa nút gửi để tránh spam
            const submitButton = parentId ? $(`#submitReply-${parentId}`) : $('#addCommentBtn');
            const originalText = submitButton.html();
            submitButton.html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang gửi...');
            submitButton.prop('disabled', true);

            $.ajax({
                url: '@Url.Action("AddComment", "Posts")',
                type: 'POST',
                data: {
                    postId: postId,
                    content: content,
                    parentCommentId: parentId
                },
                success: function(response) {
                    if (response.success) {
                        // Xóa nội dung và kích hoạt lại nút
                        commentInput.val('');
                        submitButton.html(originalText);
                        submitButton.prop('disabled', false);

                        if (parentId) {
                            // Nếu là phản hồi, thêm vào phần bình luận con
                            const replyContainer = $(`#replyContainer-${parentId}`);
                            replyContainer.hide();

                            const nestedCommentsContainer = $(`#nestedComments-${parentId}`);
                            const newReply = createNestedCommentHTML(response.comment);
                            nestedCommentsContainer.append(newReply);

                            // Hiển thị phần bình luận con nếu ẩn
                            nestedCommentsContainer.show();
                        } else {
                            // Nếu là bình luận gốc, tải lại tất cả bình luận
                            loadComments(postId, 1);
                        }

                        // Cập nhật số lượng bình luận
                        updateCommentCount(parseInt($('#commentCountText').text()) + 1);
                    } else {
                        alert(response.message || 'Đã xảy ra lỗi khi gửi bình luận.');
                        submitButton.html(originalText);
                        submitButton.prop('disabled', false);
                    }
                },
                error: function() {
                    alert('Đã xảy ra lỗi khi gửi bình luận. Vui lòng thử lại.');
                    submitButton.html(originalText);
                    submitButton.prop('disabled', false);
                }
            });
        }

        // Hàm tải bình luận
        function loadComments(postId, page) {
            currentPage = page;

            // Hiển thị loading nếu là trang đầu tiên
            if (page === 1) {
                $('#commentsList').html(`
                    <div class="text-center my-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Đang tải...</span>
                        </div>
                        <p class="mt-2">Đang tải bình luận...</p>
                    </div>
                `);
            }

            $.ajax({
                url: '@Url.Action("GetComments", "Posts")',
                type: 'GET',
                data: {
                    postId: postId,
                    page: page,
                    pageSize: 10
                },
                success: function(response) {
                    if (response.success) {
                        // Cập nhật tổng số trang và bình luận
                        totalPages = response.totalPages;
                        updateCommentCount(response.totalComments);

                        // Tạo HTML cho bình luận
                        let commentsHTML = '';

                        if (response.comments.length === 0 && page === 1) {
                            commentsHTML = `
                                <div class="text-center py-4">
                                    <i class="far fa-comment-alt fa-3x text-muted mb-3"></i>
                                    <p class="lead">Chưa có bình luận nào</p>
                                    <p class="text-muted">Hãy là người đầu tiên bình luận!</p>
                                </div>
                            `;
                        } else {
                            response.comments.forEach(comment => {
                                commentsHTML += createCommentHTML(comment);
                            });
                        }

                        // Hiển thị bình luận
                        if (page === 1) {
                            $('#commentsList').html(commentsHTML);
                        } else {
                            $('#commentsList').append(commentsHTML);
                        }

                        // Hiển thị nút tải thêm nếu còn trang
                        if (page < totalPages) {
                            $('#loadMoreContainer').show();
                        } else {
                            $('#loadMoreContainer').hide();
                        }
                    } else {
                        $('#commentsList').html(`
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                ${response.message || 'Không thể tải bình luận.'}
                            </div>
                        `);
                    }
                },
                error: function() {
                    $('#commentsList').html(`
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            Đã xảy ra lỗi khi tải bình luận. Vui lòng thử lại.
                        </div>
                    `);
                }
            });
        }

        // Tải thêm bình luận
        function loadMoreComments() {
            if (currentPage < totalPages) {
                // Hiển thị loading trong nút
                const loadMoreBtn = $('#loadMoreBtn');
                const originalText = loadMoreBtn.html();
                loadMoreBtn.html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang tải...');
                loadMoreBtn.prop('disabled', true);

                // Tải trang tiếp theo
                loadComments(@Model.Id, currentPage + 1);

                // Khôi phục nút sau 1 giây
                setTimeout(function() {
                    loadMoreBtn.html(originalText);
                    loadMoreBtn.prop('disabled', false);
                }, 1000);
            }
        }

        // Hiển thị form trả lời
        function showReplyForm(commentId) {
            // Ẩn tất cả các form trả lời khác
            $('.reply-form').hide();

            // Hiển thị form trả lời của bình luận này
            $(`#replyContainer-${commentId}`).show();
            $(`#replyContent-${commentId}`).focus();
        }

        // Xóa bình luận
        function deleteComment(commentId) {
            if (confirm('Bạn có chắc chắn muốn xóa bình luận này?')) {
                $.ajax({
                    url: '@Url.Action("DeleteComment", "Posts")',
                    type: 'POST',
                    data: { id: commentId },
                    success: function(response) {
                        if (response.success) {
                            // Xóa bình luận khỏi DOM
                            $(`#comment-${commentId}`).fadeOut(300, function() {
                                $(this).remove();

                                // Cập nhật số lượng bình luận
                                updateCommentCount(parseInt($('#commentCountText').text()) - 1);

                                // Kiểm tra nếu không còn bình luận nào
                                if ($('#commentsList').children().length === 0) {
                                    $('#commentsList').html(`
                                        <div class="text-center py-4">
                                            <i class="far fa-comment-alt fa-3x text-muted mb-3"></i>
                                            <p class="lead">Chưa có bình luận nào</p>
                                            <p class="text-muted">Hãy là người đầu tiên bình luận!</p>
                                        </div>
                                    `);
                                }
                            });
                        } else {
                            alert(response.message || 'Không thể xóa bình luận.');
                        }
                    },
                    error: function() {
                        alert('Đã xảy ra lỗi khi xóa bình luận. Vui lòng thử lại.');
                    }
                });
            }
        }

        // Cập nhật số lượng bình luận
        function updateCommentCount(count) {
            $('#commentCount').text('(' + count + ')');
            $('#commentCountText').text(count);
        }

                // Tạo HTML cho bình luận
        function createCommentHTML(comment) {
            const isCurrentUser = '@User.FindFirstValue(ClaimTypes.NameIdentifier)' === comment.userId;
            const deleteButton = isCurrentUser ?
                `<button class="comment-action text-danger" onclick="deleteComment(${comment.id})">
                    <i class="far fa-trash-alt me-1"></i> Xóa
                </button>` : '';

            const repliesHTML = comment.replies && comment.replies.length > 0 ?
                `<div class="nested-comments" id="nestedComments-${comment.id}">
                    ${comment.replies.map(reply => createNestedCommentHTML(reply)).join('')}
                </div>` :
                `<div class="nested-comments" id="nestedComments-${comment.id}" style="display: none;"></div>`;

            // Sửa đoạn này - thay vì dùng currentUserAvatar không xác định
            const currentUserAvatarHtml = @if(User.Identity.IsAuthenticated) {
                if (ViewBag.CurrentUser != null && !string.IsNullOrEmpty(ViewBag.CurrentUser.AvatarUrl))
                {
                        <text>`<img src="@ViewBag.CurrentUser.AvatarUrl" alt="Avatar" class="avatar-img">`</text>
                }
                else if (ViewBag.CurrentUser != null && !string.IsNullOrEmpty(ViewBag.CurrentUser.Avatar))
                {
                        <text>`<img src="@ViewBag.CurrentUser.Avatar" alt="Avatar" class="avatar-img">`</text>
                }
                else
                {
                        <text>'<i class="fas fa-user"></i>'</text>
                }
        } else
        {

                    <text>'<i class="fas fa-user"></i>'</text>
                }
;

        return `
            <div class="comment-item" id="comment-${comment.id}">
                <div class="comment-header">
                    <div class="comment-user">
                        <div class="avatar-sm">
                            ${comment.userAvatar ? `<img src="${comment.userAvatar}" alt="${comment.userName}" class="avatar-img">` : '<i class="fas fa-user"></i>'}
                        </div>
                        <div>
                            <p class="comment-username">${comment.userName}</p>
                            <small class="comment-date">${comment.createdDate}</small>
                        </div>
                    </div>
                </div>

                <div class="comment-content">
                    ${comment.content}
                </div>

                <div class="comment-actions">
                    <button class="comment-action" onclick="showReplyForm(${comment.id})">
                        <i class="far fa-comment me-1"></i> Trả lời
                    </button>
                    ${deleteButton}
                </div>

                <div class="reply-form" id="replyContainer-${comment.id}">
                    <div class="d-flex mt-2">
                        <div class="avatar-circle me-2" style="width: 32px; height: 32px;">
                            ${currentUserAvatarHtml}
                        </div>
                        <div class="flex-grow-1">
                            <textarea id="replyContent-${comment.id}" class="form-control form-control-sm" rows="2" placeholder="Viết phản hồi..."></textarea>
                            <div class="text-end mt-2">
                                <button class="btn btn-sm btn-light me-2" onclick="$('#replyContainer-${comment.id}').hide()">Hủy</button>
                                <button id="submitReply-${comment.id}" class="btn btn-sm btn-primary" onclick="addComment(@Model.Id, ${comment.id})">
                                    <i class="fas fa-paper-plane me-1"></i> Gửi
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                ${repliesHTML}
            </div>
        `;
    }

        // Tạo HTML cho bình luận con
        function createNestedCommentHTML(reply) {
            const isCurrentUser = '@User.FindFirstValue(ClaimTypes.NameIdentifier)' === reply.userId;
            const deleteButton = isCurrentUser ?
                `<button class="comment-action text-danger" onclick="deleteComment(${reply.id})">
                    <i class="far fa-trash-alt me-1"></i> Xóa
                </button>` : '';

            return `
                <div class="nested-comment-item" id="comment-${reply.id}">
                    <div class="comment-header">
                        <div class="comment-user">
                            <div class="avatar-sm">
                                ${reply.userAvatar ? `<img src="${reply.userAvatar}" alt="${reply.userName}" class="avatar-img">` : '<i class="fas fa-user"></i>'}
                            </div>
                            <div>
                                <p class="comment-username">${reply.userName}</p>
                                <small class="comment-date">${reply.createdDate}</small>
                            </div>
                        </div>
                    </div>

                    <div class="comment-content">
                        ${reply.content}
                    </div>

                    <div class="comment-actions">
                        ${deleteButton}
                    </div>
                </div>
            `;
        }
    </script>
}