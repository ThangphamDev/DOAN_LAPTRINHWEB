@model DOAN_LAPTRINHWEB.Models.Post
@{
    ViewData["Title"] = "Chi tiết bài viết";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow rounded">
        <div class="card-body">
            <h3 class="card-title mb-3">@Model.Title</h3>

            <div class="d-flex justify-content-between text-muted mb-3">
                <div>
                    <i class="bi bi-calendar3"></i>
                    @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                </div>
                <div>
                    <i class="bi bi-tag"></i>
                    @Model.PostType?.Name
                </div>
                <div>
                    <i class="bi bi-info-circle"></i>
                    <span class="badge
                        @(Model.ApprovalStatus == "Approved" ? "bg-success" :
                          Model.ApprovalStatus == "Rejected" ? "bg-danger" : "bg-warning text-dark")">
                        @Model.ApprovalStatus
                    </span>
                </div>
            </div>

            <hr />

            <div class="mb-3">
                @Html.Raw(Model.Content)
            </div>

            @* Nếu có ảnh: *@
            @if (!string.IsNullOrEmpty(Model.ImageUrls))
            {
                <div class="text-center mt-3">
                    <img src="@Url.Content(Model.ImageUrls)" class="img-fluid rounded" alt="Ảnh bài viết" />
                </div>
            }

            <a asp-action="MyPosts" class="btn btn-secondary mt-4">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>
