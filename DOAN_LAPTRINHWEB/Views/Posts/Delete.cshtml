
@model DOAN_LAPTRINHWEB.Models.Post

@{
    ViewData["Title"] = "Xóa bài viết";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<div class="container mt-5">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <div class="alert alert-danger">
        <h4>Bạn có chắc chắn muốn xóa bài viết "<strong>@Model.Title</strong>"?</h4>
        <p><strong>Loại:</strong> @Model.PostType?.Name</p>
        <p><strong>Ngày tạo:</strong> @Model.CreatedDate.ToString("dd/MM/yyyy")</p>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Xóa</button>
        <a asp-action="MyPosts" class="btn btn-secondary">Quay lại</a>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
}