@page
@model DOAN_LAPTRINHWEB.Areas.Identity.Pages.Account.Manage.OrdersModel
@{
    ViewData["Title"] = "Đơn mua";
    ViewData["ActivePage"] = ManageNavPages.Orders; 
}

<h2 class="text-primary fw-bold text-center mb-4">Đơn mua của bạn</h2>

@if (Model.UserOrders == null || !Model.UserOrders.Any())
{
    <div class="alert alert-info text-center" role="alert">
        Bạn chưa có đơn hàng nào.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">Ngày đặt</th>
                    <th scope="col" class="text-end">Tổng tiền</th>
                    <th scope="col">Trạng thái</th>
                    <th scope="col" class="text-center"></th> 
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.UserOrders)
                {
                    <tr>
                        <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end text-danger fw-bold">@String.Format("{0:N0} VNĐ", order.TotalAmount)</td>
                        <td>@order.OrderStatus</td>
                        <td class="text-center">
                            <a asp-page="./OrderDetails" asp-route-id="@order.OrderId" class="btn btn-info btn-sm text-white">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


