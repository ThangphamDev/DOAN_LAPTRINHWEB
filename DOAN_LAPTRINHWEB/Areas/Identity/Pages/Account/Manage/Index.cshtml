@page
@model IndexModel
@{
    ViewData["Title"] = "Hồ sơ của bạn";
    ViewData["ActivePage"] = ManageNavPages.Index;
}


    <style>
        /* Sử dụng cùng color scheme với trang chủ */
        :root {
            --primary-color: #212529;
            --secondary-color: #f8f9fa;
            --accent-color: #e9ecef;
            --text-color: #212529;
            --light-color: #ffffff;
            --danger-color: #dc3545;
            --success-color: #198754;
            --warning-color: #ffc107;
            --info-color: #0dcaf0;
            --border-radius: 8px;
            --box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            --transition: all 0.3s ease;
        }

        .profile-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, #495057 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-radius: var(--border-radius);
        }

        .profile-avatar-container {
            position: relative;
            display: inline-block;
        }

        .profile-avatar-img {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border: 4px solid white;
            box-shadow: var(--box-shadow);
            transition: var(--transition);
        }

            .profile-avatar-img:hover {
                transform: scale(1.05);
            }

        .avatar-upload-btn {
            position: absolute;
            bottom: 0;
            right: 0;
            background: var(--primary-color);
            color: white;
            border: none;
            border-radius: 50%;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 10px rgba(33, 37, 41, 0.3);
            transition: var(--transition);
        }

            .avatar-upload-btn:hover {
                background: #000;
                transform: scale(1.1);
            }

        .profile-card {
            background: var(--light-color);
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
            border: none;
            overflow: hidden;
            transition: var(--transition);
        }

            .profile-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
            }

        .form-control, .form-select {
            border: 2px solid var(--accent-color);
            border-radius: var(--border-radius);
            padding: 12px 15px;
            transition: var(--transition);
            background: var(--secondary-color);
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 0.2rem rgba(33, 37, 41, 0.25);
                background: var(--light-color);
            }

        .form-label {
            font-weight: 600;
            color: var(--text-color);
            margin-bottom: 8px;
        }

        .btn-primary {
            background: var(--primary-color);
            border: none;
            border-radius: 25px;
            padding: 12px 30px;
            font-weight: 600;
            transition: var(--transition);
            box-shadow: 0 4px 15px rgba(33, 37, 41, 0.3);
        }

            .btn-primary:hover {
                background: #000;
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(33, 37, 41, 0.4);
            }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.875rem;
            font-weight: 500;
        }

        .status-verified {
            background: rgba(25, 135, 84, 0.1);
            color: var(--success-color);
            border: 1px solid rgba(25, 135, 84, 0.2);
        }

        .status-unverified {
            background: rgba(255, 193, 7, 0.1);
            color: #856404;
            border: 1px solid rgba(255, 193, 7, 0.2);
        }

        .address-display {
            background: var(--secondary-color);
            border: 2px dashed var(--accent-color);
            border-radius: var(--border-radius);
            padding: 15px;
            min-height: 60px;
            display: flex;
            align-items: center;
            transition: var(--transition);
        }

            .address-display:hover {
                border-color: var(--primary-color);
                background: var(--light-color);
            }

        .info-card {
            background: linear-gradient(135deg, var(--primary-color), #495057);
            color: white;
            border-radius: var(--border-radius);
            padding: 1.5rem;
            margin-bottom: 1rem;
        }

        .section-divider {
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--primary-color), transparent);
            margin: 2rem 0;
            border: none;
        }

        .input-group-text {
            background: var(--success-color);
            border: none;
            padding: 8px 12px;
            border-radius: 0 var(--border-radius) var(--border-radius) 0;
        }

        .fade-in {
            animation: fadeIn 0.6s ease-in;
        }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .profile-stats {
            background: var(--light-color);
            border-radius: var(--border-radius);
            padding: 1.5rem;
            box-shadow: var(--box-shadow);
            margin-bottom: 1.5rem;
        }

        .stat-item {
            text-align: center;
            padding: 1rem;
        }

        .stat-number {
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--primary-color);
        }

        .stat-label {
            font-size: 0.875rem;
            color: #6c757d;
            margin-top: 0.25rem;
        }

        /* Scroll target */
        .scroll-target {
            scroll-margin-top: 100px;
        }

        /* Button styles đồng bộ với trang chủ */
        .btn-outline-primary {
            border-color: var(--primary-color);
            color: var(--primary-color);
            border-radius: var(--border-radius);
            transition: var(--transition);
        }

            .btn-outline-primary:hover {
                background-color: var(--primary-color);
                border-color: var(--primary-color);
                color: var(--light-color);
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(33, 37, 41, 0.2);
            }

        .btn-outline-success {
            border-color: var(--success-color);
            color: var(--success-color);
            border-radius: var(--border-radius);
            transition: var(--transition);
        }

            .btn-outline-success:hover {
                background-color: var(--success-color);
                border-color: var(--success-color);
                transform: translateY(-2px);
            }

        .btn-outline-info {
            border-color: var(--info-color);
            color: var(--info-color);
            border-radius: var(--border-radius);
            transition: var(--transition);
        }

            .btn-outline-info:hover {
                background-color: var(--info-color);
                border-color: var(--info-color);
                transform: translateY(-2px);
            }

        .btn-outline-danger {
            border-color: var(--danger-color);
            color: var(--danger-color);
            border-radius: var(--border-radius);
            transition: var(--transition);
        }

            .btn-outline-danger:hover {
                background-color: var(--danger-color);
                border-color: var(--danger-color);
                transform: translateY(-2px);
            }

        .btn-outline-warning {
            border-color: var(--warning-color);
            color: #856404;
            border-radius: var(--border-radius);
            transition: var(--transition);
        }

            .btn-outline-warning:hover {
                background-color: var(--warning-color);
                border-color: var(--warning-color);
                color: #000;
                transform: translateY(-2px);
            }

        .btn-outline-secondary {
            border-color: #6c757d;
            color: #6c757d;
            border-radius: var(--border-radius);
            transition: var(--transition);
        }

            .btn-outline-secondary:hover {
                background-color: #6c757d;
                border-color: #6c757d;
                transform: translateY(-2px);
            }

        /* Card headers */
        .card-header {
            background: var(--secondary-color) !important;
            border-bottom: 1px solid var(--accent-color);
        }

        /* Alert styles */
        .alert-danger {
            background-color: rgba(220, 53, 69, 0.1);
            border-color: rgba(220, 53, 69, 0.2);
            color: var(--danger-color);
            border-radius: var(--border-radius);
        }

        /* Text colors */
        .text-primary {
            color: var(--primary-color) !important;
        }

        .text-muted {
            color: #6c757d !important;
        }

        /* Icons colors */
        .text-success {
            color: var(--success-color) !important;
        }

        .text-warning {
            color: var(--warning-color) !important;
        }

        .text-info {
            color: var(--info-color) !important;
        }

        .text-danger {
            color: var(--danger-color) !important;
        }

        /* Background colors */
        .bg-success {
            background-color: var(--success-color) !important;
        }

        /* Hover effects giống trang chủ */
        .profile-card .card-body:hover {
            background: rgba(248, 249, 250, 0.5);
        }

        /* Input focus effects */
        .form-control:focus {
            box-shadow: 0 0 0 0.2rem rgba(33, 37, 41, 0.25);
        }

        .form-select:focus {
            box-shadow: 0 0 0 0.2rem rgba(33, 37, 41, 0.25);
        }


    </style>



<div class="container-fluid px-0">
    <!-- Profile Header -->
    <div class="profile-header fade-in">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-3 text-center">
                    <div class="profile-avatar-container">
                        <img id="profile-avatar-img"
                             src="@(string.IsNullOrEmpty(Model.Input.AvatarUrl) ? "/images/default-avatar.png" : Model.Input.AvatarUrl)"
                             alt="Ảnh đại diện"
                             class="profile-avatar-img rounded-circle" />
                        <button type="button" class="avatar-upload-btn" onclick="document.getElementById('avatarFileInput').click();">
                            <i class="fas fa-camera"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-9">
                    <h1 class="display-6 fw-bold mb-2">@ViewData["Title"]</h1>
                    <h3 class="mb-1">@Model.Username</h3>
                    <p class="mb-3 opacity-75">
                        <i class="fas fa-envelope me-2"></i>@Model.Input.Email
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        @if (Model.IsEmailConfirmed)
                        {
                            <span class="status-badge status-verified">
                                <i class="fas fa-check-circle me-1"></i> Email đã xác nhận
                            </span>
                        }
                        else
                        {
                            <span class="status-badge status-unverified">
                                <i class="fas fa-exclamation-triangle me-1"></i> Email chưa xác nhận
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <partial name="_StatusMessage" model="Model.StatusMessage" />

        <!-- Profile Stats -->
        <div class="profile-stats fade-in">
            <div class="row">
                <div class="col-md-3">
                    <div class="stat-item">
                        <div class="stat-number">
                            <i class="fas fa-user-circle text-primary"></i>
                        </div>
                        <div class="stat-label">Hồ sơ cá nhân</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-item">
                        <div class="stat-number">
                            <i class="fas fa-shield-alt text-success"></i>
                        </div>
                        <div class="stat-label">Bảo mật</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-item">
                        <div class="stat-number">
                            <i class="fas fa-map-marker-alt text-info"></i>
                        </div>
                        <div class="stat-label">Địa chỉ</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-item">
                        <div class="stat-number">
                            <i class="fas fa-cog text-warning"></i>
                        </div>
                        <div class="stat-label">Cài đặt</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="row">
            <div class="col-lg-8">
                <div class="profile-card fade-in">
                    <div class="card-header bg-transparent border-0 p-4">
                        <h4 class="mb-0">
                            <i class="fas fa-edit text-primary me-2"></i>
                            Thông tin cá nhân
                        </h4>
                        <p class="text-muted mb-0">Cập nhật thông tin hồ sơ của bạn</p>
                    </div>
                    <div class="card-body p-4">
                        <form id="profile-form" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label asp-for="Username" class="form-label">
                                        <i class="fas fa-user me-1"></i> Tên đăng nhập
                                    </label>
                                    <input asp-for="Username" class="form-control" disabled />
                                    <small class="text-muted">Tên đăng nhập không thể thay đổi</small>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Input.Email" class="form-label">
                                        <i class="fas fa-envelope me-1"></i> Email
                                    </label>
                                    <div class="input-group">
                                        <input asp-for="Input.Email" class="form-control" />
                                        @if (Model.IsEmailConfirmed)
                                        {
                                            <span class="input-group-text bg-success text-white">
                                                <i class="fas fa-check-circle me-1"></i> Đã xác nhận
                                            </span>
                                        }
                                        else
                                        {
                                            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail"
                                                    class="btn btn-outline-warning">
                                                <i class="fas fa-paper-plane me-1"></i> Xác nhận
                                            </button>
                                        }
                                    </div>
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Input.FullName" class="form-label">
                                        <i class="fas fa-id-card me-1"></i> Họ và tên
                                    </label>
                                    <input asp-for="Input.FullName" class="form-control" placeholder="Nhập họ và tên đầy đủ" />
                                    <span asp-validation-for="Input.FullName" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Input.PhoneNumber" class="form-label">
                                        <i class="fas fa-phone me-1"></i> Số điện thoại
                                    </label>
                                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
                                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Input.DateOfBirth" class="form-label">
                                        <i class="fas fa-birthday-cake me-1"></i> Ngày sinh
                                    </label>
                                    <input asp-for="Input.DateOfBirth" type="date" class="form-control" />
                                    <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Input.Gender" class="form-label">
                                        <i class="fas fa-venus-mars me-1"></i> Giới tính
                                    </label>
                                    <select asp-for="Input.Gender" class="form-select">
                                        <option value="">-- Chọn giới tính --</option>
                                        <option value="Nam">Nam</option>
                                        <option value="Nữ">Nữ</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                    <span asp-validation-for="Input.Gender" class="text-danger"></span>
                                </div>

                                <div class="col-12">
                                    <hr class="section-divider">
                                    <label class="form-label">
                                        <i class="fas fa-map-marker-alt me-1"></i> Địa chỉ mặc định
                                    </label>
                                    <div class="address-display">
                                        <div class="flex-grow-1">
                                            @if (string.IsNullOrEmpty(Model.Input.DefaultAddress))
                                            {
                                                <div class="text-center">
                                                    <i class="fas fa-home text-muted fa-2x mb-2"></i>
                                                    <p class="text-muted mb-0">Chưa có địa chỉ mặc định</p>
                                                    <small class="text-muted">Thêm địa chỉ để giao hàng nhanh hơn</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-map-marker-alt text-primary me-3"></i>
                                                    <div>
                                                        <strong>@Model.Input.DefaultAddress</strong>
                                                        <br>
                                                        <small class="text-success">
                                                            <i class="fas fa-check-circle me-1"></i>Địa chỉ mặc định
                                                        </small>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        <div class="ms-3">
                                            <a href="/Identity/Account/Manage/Addresses" class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-edit me-1"></i>Quản lý
                                            </a>
                                        </div>
                                    </div>
                                    <small class="text-muted mt-2 d-block">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Để thay đổi địa chỉ, vui lòng truy cập
                                        <a href="/Identity/Account/Manage/Addresses" class="text-decoration-none fw-bold">quản lý địa chỉ</a>
                                    </small>
                                </div>

                                <input type="file" id="avatarFileInput" name="UploadAvatar" accept="image/*" style="display: none;" />
                                <input type="hidden" asp-for="Input.AvatarUrl" />

                                <div class="col-12 text-end">
                                    <button id="update-profile-button" type="submit" class="btn btn-primary btn-lg">
                                        <i class="fas fa-save me-2"></i>Lưu thay đổi
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Quick Actions -->
                <div class="profile-card fade-in mb-4">
                    <div class="card-header bg-transparent border-0 p-4">
                        <h5 class="mb-0">
                            <i class="fas fa-bolt text-warning me-2"></i>
                            Thao tác nhanh
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-grid gap-3">
                            <a href="/Identity/Account/Manage/ChangePassword" class="btn btn-outline-primary">
                                <i class="fas fa-key me-2"></i>Đổi mật khẩu
                            </a>
                            <a href="/Identity/Account/Manage/TwoFactorAuthentication" class="btn btn-outline-success">
                                <i class="fas fa-shield-alt me-2"></i>Bảo mật 2FA
                            </a>
                            <a href="/Identity/Account/Manage/PersonalData" class="btn btn-outline-info">
                                <i class="fas fa-download me-2"></i>Tải dữ liệu
                            </a>
                            <a href="/Identity/Account/Manage/DeletePersonalData" class="btn btn-outline-danger">
                                <i class="fas fa-trash me-2"></i>Xóa tài khoản
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Account Security -->
                <div class="info-card fade-in">
                    <h5 class="mb-3">
                        <i class="fas fa-shield-alt me-2"></i>
                        Bảo mật tài khoản
                    </h5>
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="text-center">
                                @if (Model.IsEmailConfirmed)
                                {
                                    <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                                    <p class="mb-0 small">Email xác thực</p>
                                }
                                else
                                {
                                    <i class="fas fa-exclamation-triangle fa-2x text-warning mb-2"></i>
                                    <p class="mb-0 small">Email chưa xác thực</p>
                                }
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center">
                                <i class="fas fa-mobile-alt fa-2x text-info mb-2"></i>
                                <p class="mb-0 small">
                                    @(string.IsNullOrEmpty(Model.Input.PhoneNumber) ? "Chưa có SĐT" : "Có SĐT")
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 pt-3 border-top border-light">
                        <small class="opacity-75">
                            <i class="fas fa-lightbulb me-1"></i>
                            Mẹo: Xác thực email và thêm số điện thoại để tăng cường bảo mật tài khoản.
                        </small>
                    </div>
                </div>

                <!-- Help & Support -->
                <div class="profile-card fade-in mt-4">
                    <div class="card-body p-4 text-center">
                        <i class="fas fa-question-circle fa-3x text-muted mb-3"></i>
                        <h6>Cần hỗ trợ?</h6>
                        <p class="text-muted small mb-3">
                            Liên hệ với chúng tôi nếu bạn gặp khó khăn trong việc cập nhật thông tin.
                        </p>
                        <a href="#" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-headset me-1"></i>Liên hệ hỗ trợ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Avatar upload preview
        document.getElementById('avatarFileInput').addEventListener('change', function (event) {
            if (event.target.files && event.target.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('profile-avatar-img').src = e.target.result;

                    // Add upload animation
                    const img = document.getElementById('profile-avatar-img');
                    img.style.transform = 'scale(0.8)';
                    img.style.opacity = '0.7';

                    setTimeout(() => {
                        img.style.transform = 'scale(1)';
                        img.style.opacity = '1';
                    }, 200);
                };
                reader.readAsDataURL(event.target.files[0]);
            }
        });

        // Form validation enhancement
        document.getElementById('profile-form').addEventListener('submit', function(e) {
            const button = document.getElementById('update-profile-button');
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang lưu...';
            button.disabled = true;
        });

        // Add smooth scroll for validation errors
        document.addEventListener('DOMContentLoaded', function() {
            // Cuộn đến tiêu đề trong _Layout.cshtml
            const pageTitle = document.querySelector('h1.text-primary.fw-bold.text-center');
            if (pageTitle) {
                pageTitle.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

        // Add tooltips for form fields
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Enhanced form interactions
        document.querySelectorAll('.form-control, .form-select').forEach(function(element) {
            element.addEventListener('focus', function() {
                this.parentElement.classList.add('focused');
            });

            element.addEventListener('blur', function() {
                this.parentElement.classList.remove('focused');
            });
        });

        // Success message auto-hide
        const statusMessage = document.querySelector('.alert');
        if (statusMessage) {
            setTimeout(() => {
                statusMessage.style.opacity = '0';
                setTimeout(() => {
                    statusMessage.remove();
                }, 300);
            }, 5000);
        }
    </script>
}

