@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 mt-4">
    <h1 class="text-primary fw-bold text-center mb-4">Quản lý tài khoản của bạn</h1>

    <div class="row">
        <div class="col-md-3">
            <div class="position-sticky" style="top: 80px; z-index: 1020;">
                <div class="card shadow-sm mb-4 border-0">
                    <div class="card-body p-0">
                        <partial name="_ManageNav" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="card shadow-sm">
                @RenderBody()
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
