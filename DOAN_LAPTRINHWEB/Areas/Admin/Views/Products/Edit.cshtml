@model DOAN_LAPTRINHWEB.Models.Product

@{
    ViewData["Title"] = "Chỉnh Sửa Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">@ViewData["Title"]</h2>
        </div>
        <div class="card-body">
            <form asp-action="Edit" enctype="multipart/form-data" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="ProductId" />

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Tên sản phẩm</label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Price" class="form-label">Giá</label>
                                    <div class="input-group">
                                        <input asp-for="Price" class="form-control" type="number" min="0" required />
                                        <span class="input-group-text">VNĐ</span>
                                    </div>
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CategoryId" class="form-label">Danh mục</label>
                                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select" required></select>
                                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Mô tả</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <!-- Thêm trường Tồn kho -->
                        <div class="mb-3">
                            <label asp-for="Stock" class="form-label">Tồn kho</label>
                            <input asp-for="Stock" class="form-control" type="number" min="0" required />
                            <span asp-validation-for="Stock" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <!-- Main Image -->
                        <div class="mb-3 border p-3 rounded bg-light">
                            <label class="form-label d-block fw-bold">Hình ảnh đại diện</label>

                            @{
                                var primaryImage = Model.ProductImages?.FirstOrDefault(img => img.IsPrimary == true);
                                var mainImageUrl = primaryImage?.ImageUrl ?? "/images/no-image.jpg";
                            }

                            <div class="text-center mb-3">
                                <img src="@mainImageUrl" alt="@Model.Name" id="mainPreviewCurrent" class="img-fluid rounded mb-2" style="max-height: 200px;" />
                                <div class="text-muted small">Hình ảnh hiện tại</div>
                            </div>

                            <div class="mt-3">
                                <label for="mainImageUpload" class="form-label">Thay đổi ảnh đại diện:</label>
                                <input type="file" name="PrimaryImage" id="mainImageUpload" class="form-control" accept="image/*" />
                                <small class="text-muted">Để trống nếu không muốn thay đổi ảnh</small>
                            </div>

                            <div id="mainImagePreview" class="mt-3 text-center d-none">
                                <div class="fw-bold mb-1">Hình ảnh mới</div>
                                <img id="mainPreview" src="#" class="img-fluid rounded" style="max-height: 200px;" />
                            </div>
                        </div>

                        <!-- Additional Images -->
                        <div class="mb-3 border p-3 rounded bg-light">
                            <label class="form-label d-block fw-bold">Hình ảnh bổ sung</label>

                            @if (Model.ProductImages != null && Model.ProductImages.Any(img => img.IsPrimary != true))
                            {
                                <div class="mb-3">
                                    <div class="fw-bold mb-2">Hình ảnh hiện có</div>
                                    <div class="d-flex flex-wrap gap-2" id="existingImages">
                                        @foreach (var image in Model.ProductImages.Where(img => img.IsPrimary != true))
                                        {
                                            <div class="position-relative image-item" data-image-id="@image.ImageId">
                                                <img src="@image.ImageUrl" alt="Image" class="img-thumbnail" style="width: 80px; height: 80px; object-fit: cover;" />
                                                <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-1 rounded-circle p-0 delete-image-btn"
                                                        style="width: 20px; height: 20px; font-size: 10px;"
                                                        data-image-id="@image.ImageId">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted mb-3" id="noImagesMessage">
                                    <i class="fas fa-images fa-2x mb-2"></i>
                                    <p>Chưa có ảnh phụ</p>
                                </div>
                            }

                            <div class="mt-3">
                                <div class="fw-bold mb-2">Thêm hình ảnh mới</div>
                                <input type="file" name="AdditionalImages" id="additionalImages" multiple class="form-control" accept="image/*" />
                                <small class="text-muted d-block mb-2">Có thể chọn nhiều hình ảnh</small>
                                <div id="additionalImagesPreview" class="mt-2 d-flex flex-wrap gap-2">
                                    <!-- Additional images previews will be added here -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Cập Nhật
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Quay Lại
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.ProductId" class="btn btn-danger ms-auto">
                        <i class="fas fa-trash me-2"></i>Xóa Sản Phẩm
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Main image preview functionality
        document.getElementById('mainImageUpload').addEventListener('change', function(event) {
            const preview = document.getElementById('mainPreview');
            const previewContainer = document.getElementById('mainImagePreview');

            if (event.target.files && event.target.files[0]) {
                const reader = new FileReader();

                reader.onload = function(e) {
                    preview.src = e.target.result;
                    previewContainer.classList.remove('d-none');
                }

                reader.readAsDataURL(event.target.files[0]);
            } else {
                preview.src = '';
                previewContainer.classList.add('d-none');
            }
        });

        // Additional images preview functionality
        document.getElementById('additionalImages').addEventListener('change', function(event) {
            const previewContainer = document.getElementById('additionalImagesPreview');
            previewContainer.innerHTML = ''; // Clear previous previews

            if (event.target.files && event.target.files.length > 0) {
                // Hide "no images" message if visible
                const noImagesMsg = document.getElementById('noImagesMessage');
                if (noImagesMsg) {
                    noImagesMsg.style.display = 'none';
                }

                Array.from(event.target.files).forEach(file => {
                    const reader = new FileReader();

                    reader.onload = function(e) {
                        const previewDiv = document.createElement('div');
                        previewDiv.className = 'position-relative';

                        const img = document.createElement('img');
                        img.src = e.target.result;
                        img.className = 'img-thumbnail';
                        img.style.width = '80px';
                        img.style.height = '80px';
                        img.style.objectFit = 'cover';

                        const badge = document.createElement('span');
                        badge.className = 'badge bg-info position-absolute bottom-0 end-0 m-1';
                        badge.textContent = 'Mới';

                        previewDiv.appendChild(img);
                        previewDiv.appendChild(badge);
                        previewContainer.appendChild(previewDiv);
                    }

                    reader.readAsDataURL(file);
                });
            }
        });

        // Delete image functionality
        document.querySelectorAll('.delete-image-btn').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();

                const imageId = this.getAttribute('data-image-id');
                const imageContainer = this.closest('.image-item');

                if (confirm('Bạn có chắc chắn muốn xóa ảnh này không?')) {
                    // Create AJAX request to delete the image
                    fetch('/Products/RemoveImage/' + imageId, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            // Add CSRF token
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Không thể xóa hình ảnh');
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            // Remove image from DOM
                            imageContainer.remove();

                            // Show "no images" message if all images were removed
                            const remainingImages = document.querySelectorAll('.image-item');
                            if (remainingImages.length === 0) {
                                const noImagesMsg = document.getElementById('noImagesMessage');
                                if (noImagesMsg) {
                                    noImagesMsg.style.display = 'block';
                                } else {
                                    // Create "no images" message if it doesn't exist
                                    const existingImagesContainer = document.getElementById('existingImages');
                                    if (existingImagesContainer) {
                                        existingImagesContainer.innerHTML = `
                                            <div class="text-center text-muted mb-3" id="noImagesMessage">
                                                <i class="fas fa-images fa-2x mb-2"></i>
                                                <p>Chưa có ảnh phụ</p>
                                            </div>`;
                                    }
                                }
                            }

                            // Show success message
                            alert('Đã xóa ảnh thành công');
                        } else {
                            alert('Không thể xóa hình ảnh: ' + (data.message || 'Lỗi không xác định'));
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Lỗi khi xóa hình ảnh: ' + error.message);
                    });
                }
            });
        });

        // Validate file sizes when form is submitted
        document.querySelector('form').addEventListener('submit', function(e) {
            const mainImageUpload = document.getElementById('mainImageUpload');

            // Kiểm tra kích thước file ảnh chính nếu có
            if (mainImageUpload.files.length > 0) {
                const maxSize = 2 * 1024 * 1024; // 2MB
                if (mainImageUpload.files[0].size > maxSize) {
                    e.preventDefault();
                    alert('Hình ảnh đại diện không được vượt quá 2MB');
                    return false;
                }
            }

            // Kiểm tra các file ảnh phụ nếu có
            const additionalImages = document.getElementById('additionalImages');
            if (additionalImages.files.length > 0) {
                const maxSize = 2 * 1024 * 1024; // 2MB
                for (let i = 0; i < additionalImages.files.length; i++) {
                    if (additionalImages.files[i].size > maxSize) {
                        e.preventDefault();
                        alert(`Hình ảnh phụ "${additionalImages.files[i].name}" vượt quá 2MB`);
                        return false;
                    }
                }
            }

            return true;
        });
    </script>
}