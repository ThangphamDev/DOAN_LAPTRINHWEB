@model DOAN_LAPTRINHWEB.Models.Product

@{
    ViewData["Title"] = "Xóa Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .product-image {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: 8px;
        border: 2px solid #dee2e6;
    }
</style>

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-trash-alt text-danger"></i> Xóa Sản Phẩm
        </h1>
    </div>

    <!-- Warning Alert -->
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa sản phẩm này không? Hành động này không thể hoàn tác.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <!-- Product Info Card -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-danger">
            <h6 class="m-0 font-weight-bold text-white">
                <i class="fas fa-info-circle"></i> Thông tin sản phẩm sẽ bị xóa
            </h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 text-center">
                    @{
                        var primaryImage = Model.ProductImages?.FirstOrDefault(img => img.IsPrimary == true);
                        var imageUrl = primaryImage?.ImageUrl ?? "/images/no-image.jpg";
                    }
                    <img src="@imageUrl" alt="@Model.Name" class="product-image mb-3">
                    <h5 class="fw-bold">@Model.Name</h5>
                    <p class="text-danger fw-bold fs-4">@(Model.Price.ToString("N0"))₫</p>
                </div>
                <div class="col-md-9">
                    <div class="table-responsive">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <td class="fw-bold text-gray-600" width="150">Mã sản phẩm:</td>
                                    <td>#@Model.ProductId</td>
                                    <td class="fw-bold text-gray-600" width="150">Danh mục:</td>
                                    <td>
                                        @if (Model.Category != null)
                                        {
                                            <span class="badge bg-primary">@Model.Category.Name</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Chưa phân loại</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-gray-600">Giá bán:</td>
                                    <td class="text-danger fw-bold">@(Model.Price.ToString("N0"))₫</td>
                                    <td class="fw-bold text-gray-600">Tồn kho:</td>
                                    <td>
                                        @if (Model.Stock > 10)
                                        {
                                            <span class="badge bg-success">@Model.Stock</span>
                                        }
                                        else if (Model.Stock > 0)
                                        {
                                            <span class="badge bg-warning">@Model.Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Hết hàng</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-gray-600">Ngày tạo:</td>
                                    <td>@(Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                    <td class="fw-bold text-gray-600">Cập nhật cuối:</td>
                                    <td>@(Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-gray-600">Số lượng ảnh:</td>
                                    <td>@(Model.ProductImages?.Count() ?? 0) ảnh</td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mt-3">
                            <h6 class="fw-bold text-gray-600 mb-2">Mô tả sản phẩm:</h6>
                            <div class="bg-gray-100 p-3 rounded">
                                @Model.Description
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Action Card -->
    <div class="card shadow">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="text-muted">
                        <i class="fas fa-info-circle me-2"></i>
                        Việc xóa sản phẩm sẽ ảnh hưởng đến các đơn hàng đã có sản phẩm này và dữ liệu thống kê.
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" asp-for="ProductId" />
                        <a asp-action="Index" class="btn btn-secondary me-2">
                            <i class="fas fa-arrow-left"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-danger"
                                onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?')">
                            <i class="fas fa-trash-alt"></i> Xóa sản phẩm
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
