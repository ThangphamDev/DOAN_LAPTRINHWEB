@model DOAN_LAPTRINHWEB.Models.Category

@{
    ViewData["Title"] = "Thêm Danh Mục";
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-header bg-white border-0">
                <h4 class="card-title mb-0">Thêm Danh Mục Mới</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Tên danh mục" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Type" class="form-label fw-semibold"></label>
                        <input asp-for="Type" class="form-control" placeholder="Loại" />
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <input type="submit" value="Thêm" class="btn btn-primary px-4" />
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}