@model DOAN_LAPTRINHWEB.Models.Category

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
    Layout = "/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-edit"></i> Chỉnh sửa danh mục
        </h1>
    </div>

    <!-- Main Content -->
    <div class="row">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-info-circle"></i> Thông tin danh mục
                    </h6>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="CategoryId" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Name" class="form-label fw-bold">
                                        <i class="fas fa-tag me-1"></i> Tên danh mục
                                    </label>
                                    <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục..." />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Type" class="form-label fw-bold">
                                        <i class="fas fa-layer-group me-1"></i> Loại danh mục
                                    </label>
                                    <input asp-for="Type" class="form-control" placeholder="Nhập loại danh mục..." />
                                    <span asp-validation-for="Type" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="form-group mt-4">
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-1"></i> Lưu thay đổi
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left me-1"></i> Quay lại
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Side Panel (Optional) -->
        <div class="col-lg-4 col-md-2">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-success">
                        <i class="fas fa-lightbulb"></i> Gợi ý
                    </h6>
                </div>
                <div class="card-body">
                    <div class="text-center">
                        <i class="fas fa-info-circle fa-2x text-gray-300 mb-3"></i>
                        <p class="text-gray-600 small mb-2">
                            <strong>Tên danh mục:</strong> Nên ngắn gọn, dễ hiểu
                        </p>
                        <p class="text-gray-600 small mb-2">
                            <strong>Loại danh mục:</strong> Phân loại theo nhóm sản phẩm
                        </p>
                        <p class="text-gray-600 small">
                            Ví dụ: Nội thất, Trang trí, Đồ dùng...
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Form validation enhancement
        $(document).ready(function() {
            // Add Bootstrap validation classes
            $('form').on('submit', function(e) {
                var isValid = true;

                // Check required fields
                $('input[required]').each(function() {
                    if ($(this).val().trim() === '') {
                        $(this).addClass('is-invalid');
                        isValid = false;
                    } else {
                        $(this).removeClass('is-invalid').addClass('is-valid');
                    }
                });

                if (!isValid) {
                    e.preventDefault();
                    toastr.error('Vui lòng điền đầy đủ thông tin bắt buộc!');
                }
            });

            // Real-time validation
            $('input').on('blur', function() {
                if ($(this).attr('required') && $(this).val().trim() === '') {
                    $(this).addClass('is-invalid');
                } else {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                }
            });
        });
    </script>
}
