@model DOAN_LAPTRINHWEB.Areas.Admin.Controllers.UserEditViewModel

@{
    ViewData["Title"] = "Chỉnh sửa người dùng";
}

<h1>Chỉnh sửa người dùng</h1>

<div class="card">
    <div class="card-header">
        <h4>Chỉnh sửa: @Model.FullName</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <dt class="col-sm-3">Tên người dùng</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Số điện thoại</dt>
                <dd class="col-sm-9">@Model.PhoneNumber</dd>
            </div>

            <div class="form-group">
                <label asp-for="Status" class="control-label">Trạng thái</label>
                <select asp-for="Status" class="form-control">
                    @foreach (var status in ViewBag.Statuses)
                    {
                        <option value="@status" selected="@(status == Model.Status)">@status</option>
                    }
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <input asp-for="EmailConfirmed" class="form-check-input" type="checkbox" />
                <label asp-for="EmailConfirmed" class="form-check-label">Xác nhận Email</label>
            </div>

            <h4>Vai trò</h4>
            @for (int i = 0; i < Model.Roles.Count; i++)
            {
                @if (Model.Roles[i].Name != "Admin")
                {
                    <div class="form-check">
                        <input type="hidden" asp-for="Roles[i].Id" />
                        <input type="hidden" asp-for="Roles[i].Name" />
                        <input asp-for="Roles[i].IsSelected" class="form-check-input" type="checkbox" />
                        <label class="form-check-label">@Model.Roles[i].Name</label>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="Roles[i].Id" />
                    <input type="hidden" asp-for="Roles[i].Name" />
                    <input type="hidden" asp-for="Roles[i].IsSelected" value="@Model.Roles[i].IsSelected" />
                }
            }

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">×</span>
        </button>
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}