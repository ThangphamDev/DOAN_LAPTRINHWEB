@model DOAN_LAPTRINHWEB.Areas.Admin.Controllers.UserEditViewModel

@{
    ViewData["Title"] = "Chỉnh sửa người dùng";
}

<div class="container mt-4">
    <h2>Chỉnh sửa người dùng</h2>
    <hr />

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-@TempData["MessageType"] alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FullName" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="PhoneNumber" />
                <input type="hidden" asp-for="EmailConfirmed" />

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Họ và Tên</label>
                    <input asp-for="FullName" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label">Trạng thái</label>
                    <select asp-for="Status" class="form-control" asp-items="@(new SelectList(ViewBag.Statuses))">
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Vai trò</label>
                    @for (int i = 0; i < Model.Roles.Count; i++)
                    {
                        <div class="form-check">
                            <input type="hidden" asp-for="Roles[i].Id" />
                            <input type="hidden" asp-for="Roles[i].Name" />
                            <input asp-for="Roles[i].IsSelected" type="checkbox" class="form-check-input" />
                            <label asp-for="Roles[i].IsSelected" class="form-check-label">
                                @Model.Roles[i].Name
                            </label>
                        </div>
                    }
                    <span asp-validation-for="Roles" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}