@model IEnumerable<DOAN_LAPTRINHWEB.Areas.Admin.Controllers.UserViewModel>

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<h1>Quản lý người dùng</h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Họ và tên</th>
            <th>Email</th>
            <th>Số điện thoại</th>
            <th>Trạng thái</th>
            <th>Xác nhận Email</th>
            <th>Vai trò</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@user.PhoneNumber</td>
                <td>
                    @if (user.Status == "Đang hoạt động" || user.Status == "Active")
                    {
                        <span class="badge bg-success text-white">@user.Status</span>
                    }
                    else if (user.Status == "Tạm khóa" || user.Status == "Locked" || user.Status == "Inactive")
                    {
                        <span class="badge bg-danger text-white">@user.Status</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary text-white">@user.Status</span>
                    }
                </td>
                <td>@(user.EmailConfirmed ? "Đã xác nhận" : "Chưa xác nhận")</td>
                <td>@string.Join(", ", user.Roles)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-info btn-sm">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-primary btn-sm">Chỉnh sửa</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.table').DataTable({
                "order": [[0, "asc"]],
                "pageLength": 10,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.21/i18n/Vietnamese.json"
                }
            });
        });
    </script>
}
