@*
    Modern Admin Layout - Responsive Sidebar & Topbar
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    
</head>
<body>
    <div class="admin-sidebar">
        <div class="sidebar-header">
            <i class="fas fa-cubes me-2"></i> <span>Admin HomeStyle</span>
        </div>
        <nav class="flex-grow-1">
            <ul class="nav flex-column mt-3">
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")"
                       asp-area="Admin" asp-controller="Admin" asp-action="Dashboard">
                        <i class="fas fa-tachometer-alt"></i> <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")"
                       asp-area="Admin" asp-controller="Products" asp-action="Index">
                        <i class="fas fa-box"></i> <span>Sản phẩm</span>
                    </a>
                </li>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")"
                       asp-area="Admin" asp-controller="Categories" asp-action="Index">
                        <i class="fas fa-tags"></i> <span>Danh mục</span>
                    </a>
                </li>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")"
                       asp-area="Admin" asp-controller="Orders" asp-action="Index">
                        <i class="fas fa-shopping-cart"></i> <span>Đơn hàng</span>
                    </a>
                </li>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")"
                       asp-area="Admin" asp-controller="Users" asp-action="Index">
                        <i class="fas fa-users"></i> <span>Người dùng</span>
                    </a>
                </li>
                <li>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Posts" ? "active" : "")"
                       asp-area="Admin" asp-controller="Posts" asp-action="Index">
                        <i class="fas fa-newspaper"></i> <span>Bài viết</span>
                    </a>
                </li>
            </ul>
        </nav>
        <div class="sidebar-footer">
            © @DateTime.Now.Year HomeStyle Admin
        </div>
    </div>
    <div class="admin-main">
        <div class="admin-topbar">
            <div>
                <span class="fw-bold">@ViewData["Title"]</span>
            </div>
            <div class="user-dropdown">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <button class="btn btn-light dropdown-toggle" type="button">
                        <i class="fas fa-user-circle me-2"></i>@User.Identity?.Name
                    </button>
                    <div class="user-dropdown-content">
                        <form asp-area="Identity" asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                              method="post">
                            <button type="submit" class="btn btn-link text-dark w-100 text-start px-3 py-2">
                                <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login">
                        <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                    </a>
                }
            </div>
        </div>
        <div class="admin-main-content">
            @RenderBody()
        </div>
        <footer class="admin-footer">
            <span>© @DateTime.Now.Year - HomeStyle Admin Dashboard</span>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
