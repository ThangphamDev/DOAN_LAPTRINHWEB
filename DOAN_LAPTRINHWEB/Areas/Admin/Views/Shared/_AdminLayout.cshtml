<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar-->
        <div class="border-end bg-dark" id="sidebar-wrapper">
            <div class="sidebar-heading border-bottom bg-dark text-white">HomeStyle Admin</div>
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action bg-dark text-white p-3" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="fas fa-tachometer-alt me-2"></i> Dashboard
                </a>
                <a class="list-group-item list-group-item-action bg-dark text-white p-3" asp-area="Admin" asp-controller="Products" asp-action="Index">
                    <i class="fas fa-box me-2"></i> Quản lý sản phẩm
                </a>
                <a class="list-group-item list-group-item-action bg-dark text-white p-3" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                    <i class="fas fa-tags me-2"></i> Quản lý danh mục
                </a>
                <a class="list-group-item list-group-item-action bg-dark text-white p-3" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                    <i class="fas fa-shopping-cart me-2"></i> Quản lý đơn hàng
                </a>
                <a class="list-group-item list-group-item-action bg-dark text-white p-3" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="fas fa-users me-2"></i> Quản lý người dùng
                </a>
                <a class="list-group-item list-group-item-action bg-dark text-white p-3" asp-controller="Home" asp-action="Index" asp-area="">
                    <i class="fas fa-home me-2"></i> Về trang chủ
                </a>
            </div>
        </div>
        <!-- Page content wrapper-->
        <div id="page-content-wrapper">
            <!-- Top navigation-->
            <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
                <div class="container-fluid">
                    <button class="btn btn-dark" id="sidebarToggle"><i class="fas fa-bars"></i></button>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav ms-auto mt-2 mt-lg-0">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" id="navbarDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="fas fa-user-circle me-1"></i> Admin
                                </a>
                                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Hồ sơ</a>
                                    <div class="dropdown-divider"></div>
                                    <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="dropdown-item p-0">
                                        <button type="submit" class="btn btn-link text-dark text-decoration-none w-100 text-start ps-3 pe-3 py-2">Đăng xuất</button>
                                    </form>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
            <!-- Page content-->
            <div class="container-fluid p-4">
                <h1 class="mt-2 mb-4">@ViewData["Title"]</h1>
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>

    <script>
        // Simple sidebar toggle script
        window.addEventListener('DOMContentLoaded', event => {
            const sidebarToggle = document.getElementById('sidebarToggle');
            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', event => {
                    event.preventDefault();
                    document.querySelector('body').classList.toggle('sb-sidenav-toggled');
                    localStorage.setItem('sb|sidebar-toggle', document.querySelector('body').classList.contains('sb-sidenav-toggled'));
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>