@model DOAN_LAPTRINHWEB.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<h1>Chi tiết đơn hàng</h1>

<div class="card">
    <div class="card-header">
        <h4>Đơn hàng #@Model.OrderId</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Người dùng</dt>
            <dd class="col-sm-9">@Model.User?.FullName</dd>

            <dt class="col-sm-3">Tổng tiền</dt>
            <dd class="col-sm-9">@Model.TotalAmount.ToString("C")</dd>

            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">
                <form asp-action="UpdateStatus" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.OrderId" />
                    <select name="status" class="form-control d-inline w-auto" onchange="this.form.submit()">
                        @foreach (var status in ViewBag.Statuses)
                        {
                            <option value="@status" selected="@(status == Model.OrderStatus)">@status</option>
                        }
                    </select>
                </form>
            </dd>

            <dt class="col-sm-3">Ngày tạo</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Ngày cập nhật</dt>
            <dd class="col-sm-9">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>

        <h4>Chi tiết đơn hàng</h4>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Giá</th>
                    <th>Tổng</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    <tr>
                        <td>@item.Product?.Name</td>
                        <td>@item.Quantity</td>
                        <td>@item.Price.ToString("C")</td>
                        <td>@((item.Quantity * item.Price).ToString("C"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa đơn hàng này?');">
            <input type="hidden" name="id" value="@Model.OrderId" />
            <button type="submit" class="btn btn-danger">Xóa</button>
        </form>
    </div>
</div>